                else
                {
                    <div class="dashboard-empty-state">

                        <i class="bi bi-clock-history"></i>

                        <h6>
                            Henüz aktivite bulunmuyor
                        </h6>

                        <span>
                            Sistemde işlem yapıldığında son aktiviteler burada
                            görüntülenecektir.
                        </span>

                    </div>
