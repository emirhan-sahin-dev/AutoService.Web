@model AutoService.Dto.ServiceOperationDtos.AddServiceOperationPartDto

@{
    ViewData["Title"] = "Yedek Parça Ekle";
}

<div class="page-header">

    <div>

        <div class="page-header-label">
            <i class="bi bi-box-seam-fill"></i>
            Servis İşlemleri
        </div>

        <h1>Yedek Parça Ekle</h1>

        <p>
            Servis işleminde kullanılan parçayı seçin ve kullanılacak adedi girin.
        </p>

    </div>

    <a asp-action="Detail"
       asp-route-id="@Model.ServiceOperationId"
       class="btn-app-secondary">

        <i class="bi bi-arrow-left"></i>
        İşlem Detayına Dön

    </a>

</div>

<div class="row g-4">

    <div class="col-xl-8">

        <div class="app-card">

            <div class="app-card-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="chart-header-icon icon-warning">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>

                    <div class="app-card-title">

                        <h5>Parça Bilgileri</h5>

                        <span>
                            Stokta bulunan parçalar arasından seçim yapın
                        </span>

                    </div>

                </div>

            </div>

            <div class="app-card-body">

                <form asp-action="AddPart"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input asp-for="ServiceOperationId"
                           type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="row g-4">

                        <div class="col-12">

                            <div class="app-form-group">

                                <label class="app-form-label">

                                    <i class="bi bi-car-front-fill"></i>
                                    Servis İşlemi

                                </label>

                                <div class="form-control bg-light">

                                    @(ViewBag.VehiclePlate ?? "-")
                                    /
                                    @(ViewBag.OperationTypeName ?? "-")

                                </div>

                            </div>

                        </div>

                        <div class="col-md-8">

                            <div class="app-form-group">

                                <label asp-for="SparePartId"
                                       class="app-form-label">

                                    <i class="bi bi-box-seam-fill"></i>
                                    Yedek Parça
                                    <span>*</span>

                                </label>

                                <div class="app-select-wrapper">

                                    <i class="bi bi-search"></i>

                                    <select asp-for="SparePartId"
                                            asp-items="ViewBag.SpareParts"
                                            class="app-form-control app-form-select">

                                        <option value="">
                                            Yedek parça seçiniz
                                        </option>

                                    </select>

                                </div>

                                <span asp-validation-for="SparePartId"
                                      class="app-validation-message">
                                </span>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="app-form-group">

                                <label asp-for="Quantity"
                                       class="app-form-label">

                                    <i class="bi bi-123"></i>
                                    Adet
                                    <span>*</span>

                                </label>

                                <div class="app-input-wrapper">

                                    <i class="bi bi-hash"></i>

                                    <input asp-for="Quantity"
                                           type="number"
                                           min="1"
                                           class="app-form-control" />

                                </div>

                                <span asp-validation-for="Quantity"
                                      class="app-validation-message">
                                </span>

                            </div>

                        </div>

                    </div>

                    <div class="service-detail-form-notice">

                        <i class="bi bi-info-circle-fill"></i>

                        <div>

                            <strong>Stok işlemi</strong>

                            <span>
                                Parça eklendiğinde kullanılan adet stoktan otomatik düşülür.
                                Aynı parça tekrar eklenirse mevcut adet artırılır.
                            </span>

                        </div>

                    </div>

                    <div class="app-form-actions">

                        <a asp-action="Detail"
                           asp-route-id="@Model.ServiceOperationId"
                           class="btn-app-secondary">

                            <i class="bi bi-x-circle"></i>
                            Vazgeç

                        </a>

                        <button type="submit"
                                class="btn-app-primary">

                            <i class="bi bi-check-circle-fill"></i>
                            Parçayı Ekle

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <div class="col-xl-4">

        <div class="app-card form-info-card">

            <div class="form-info-icon">
                <i class="bi bi-box-seam-fill"></i>
            </div>

            <h5>Parça Kullanımı</h5>

            <p>
                Kullanılan parçanın fiyatı işlem anında kaydedilir.
                Daha sonra stok kartındaki fiyat değişse bile bu servis kaydı etkilenmez.
            </p>

            <ul class="form-info-list">

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Stok otomatik azalır
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Birim fiyat otomatik alınır
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Toplam tutar otomatik hesaplanır
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Silinirse stok geri yüklenir
                </li>

            </ul>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}