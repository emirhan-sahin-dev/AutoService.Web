@using AutoService.Web.Security
@model List<AutoService.Dto.ServiceRecordDtos.ResultServiceRecordDto>

@{
    ViewData["Title"] = "Servis Kayıtları";

    var keyword = ViewBag.Keyword as string;

    var currentPage = ViewBag.CurrentPage != null
        ? Convert.ToInt32(ViewBag.CurrentPage)
        : 1;

    var totalPage = ViewBag.TotalPage != null
        ? Convert.ToInt32(ViewBag.TotalPage)
        : 1;

    var totalCount = ViewBag.TotalCount != null
        ? Convert.ToInt32(ViewBag.TotalCount)
        : Model?.Count ?? 0;

    var customerCount = (Model ?? new List<AutoService.Dto.ServiceRecordDtos.ResultServiceRecordDto>())
        .Where(x => !string.IsNullOrWhiteSpace(x.CustomerName))
        .Select(x => x.CustomerName)
        .Distinct()
        .Count();

    var upcomingDeliveryCount = (Model ?? new List<AutoService.Dto.ServiceRecordDtos.ResultServiceRecordDto>()).Count(x =>
        x.EstimatedDeliveryDate.HasValue &&
        !x.ActualDeliveryDate.HasValue &&
        x.EstimatedDeliveryDate.Value.Date >= DateTime.Today);

    var canManageServices =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.ServiceAdvisor);
}

<!-- SAYFA BAŞLIĞI -->
<div class="page-header">

    <div>

        <div class="page-header-label">
            <i class="bi bi-tools"></i>
            Servis Yönetimi
        </div>

        <h1>Servis Kayıtları</h1>

        <p>
            Araçların servis girişlerini, tahmini teslim tarihlerini
            ve mevcut durumlarını yönetin.
        </p>

    </div>

    @if (canManageServices)
    {
        <a asp-action="Create"
           class="btn-app-primary">

            <i class="bi bi-plus-circle-fill"></i>
            Yeni Servis Kaydı

        </a>
    }

</div>

<!-- BAŞARI VE HATA MESAJLARI -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4"
         role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Kapat">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4"
         role="alert">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Kapat">
        </button>

    </div>
}

<!-- ÖZET KARTLARI -->
<div class="row g-4 mb-4">

    <div class="col-xl-4 col-md-6">

        <div class="dashboard-alert dashboard-alert-primary">

            <div class="dashboard-alert-icon icon-primary">
                <i class="bi bi-clipboard2-check-fill"></i>
            </div>

            <div class="dashboard-alert-content">

                <strong>
                    @totalCount
                </strong>

                <span>
                    Arama sonucundaki servis kaydı
                </span>

            </div>

        </div>

    </div>

    <div class="col-xl-4 col-md-6">

        <div class="dashboard-alert dashboard-alert-success">

            <div class="dashboard-alert-icon icon-success">
                <i class="bi bi-people-fill"></i>
            </div>

            <div class="dashboard-alert-content">

                <strong>
                    @customerCount
                </strong>

                <span>
                    Bu sayfadaki farklı müşteri
                </span>

            </div>

        </div>

    </div>

    <div class="col-xl-4 col-md-12">

        <div class="dashboard-alert dashboard-alert-warning">

            <div class="dashboard-alert-icon icon-warning">
                <i class="bi bi-calendar-event-fill"></i>
            </div>

            <div class="dashboard-alert-content">

                <strong>
                    @upcomingDeliveryCount
                </strong>

                <span>
                    Yaklaşan tahmini teslim
                </span>

            </div>

        </div>

    </div>

</div>

<!-- SERVİS LİSTESİ -->
<div class="app-card">

    <div class="app-card-header">

        <div class="d-flex align-items-center gap-3">

            <div class="chart-header-icon icon-primary">
                <i class="bi bi-wrench-adjustable-circle-fill"></i>
            </div>

            <div class="app-card-title">

                <h5>
                    Servis Listesi
                </h5>

                <span>
                    Plaka veya müşteri adına göre servis kaydı arayın
                </span>

            </div>

        </div>

        <span class="app-badge app-badge-primary">

            <i class="bi bi-database"></i>

            @totalCount kayıt

        </span>

    </div>

    <!-- ARAMA -->
    <div class="app-card-body">

        <form method="get"
              asp-action="Index"
              class="customer-filter-form">

            <div class="customer-search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       name="keyword"
                       value="@keyword"
                       placeholder="Plaka veya müşteri adı ile ara..."
                       autocomplete="off" />

            </div>

            <button type="submit"
                    class="btn-app-primary">

                <i class="bi bi-search"></i>
                Ara

            </button>

            @if (!string.IsNullOrWhiteSpace(keyword))
            {
                <a asp-action="Index"
                   class="btn-app-secondary">

                    <i class="bi bi-x-circle"></i>
                    Temizle

                </a>
            }

        </form>

    </div>

    <!-- TABLO -->
    <div class="app-card-body p-0">

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table app-table align-middle mb-0">

                    <thead>

                        <tr>

                            <th>
                                Servis Kaydı
                            </th>

                            <th>
                                Müşteri
                            </th>

                            <th>
                                Giriş Tarihi
                            </th>

                            <th>
                                Tahmini Teslim
                            </th>

                            <th>
                                Durum
                            </th>

                            <th class="text-end">
                                İşlemler
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            DateTime? estimatedDate = null;

                            if (item.EstimatedDeliveryDate.HasValue &&
                            item.EstimatedDeliveryDate.Value.Year > 1)
                            {
                                estimatedDate =
                                item.EstimatedDeliveryDate.Value.Date;
                            }

                            var remainingDays = estimatedDate.HasValue
                            ? (estimatedDate.Value - DateTime.Today).Days
                            : 0;

                            var isDelivered =
                            item.ActualDeliveryDate.HasValue;

                            var deliveryText = "Belirtilmedi";
                            var deliveryClass = "app-badge app-badge-secondary";
                            var deliveryIcon = "bi-calendar-x";

                            if (isDelivered)
                            {
                                deliveryText = "Teslim edildi";
                                deliveryClass = "app-badge app-badge-success";
                                deliveryIcon = "bi-check-circle-fill";
                            }
                            else if (estimatedDate.HasValue)
                            {
                                if (remainingDays < 0)
                                {
                                    deliveryText =
                                    $"{Math.Abs(remainingDays)} gün gecikti";

                                    deliveryClass =
                                    "app-badge app-badge-danger";

                                    deliveryIcon =
                                    "bi-exclamation-octagon-fill";
                                }
                                else if (remainingDays == 0)
                                {
                                    deliveryText = "Bugün";

                                    deliveryClass =
                                    "app-badge app-badge-warning";

                                    deliveryIcon =
                                    "bi-clock-fill";
                                }
                                else if (remainingDays == 1)
                                {
                                    deliveryText = "Yarın";

                                    deliveryClass =
                                    "app-badge app-badge-warning";

                                    deliveryIcon =
                                    "bi-clock-fill";
                                }
                                else
                                {
                                    deliveryText =
                                    $"{remainingDays} gün kaldı";

                                    deliveryClass =
                                    "app-badge app-badge-success";

                                    deliveryIcon =
                                    "bi-calendar-check-fill";
                                }
                            }
                            var rowClass = string.Empty;

                            if (isDelivered)
                            {
                                rowClass = "service-row-delivered";
                            }
                            else if (estimatedDate.HasValue && remainingDays < 0)
                            {
                                rowClass = "service-row-overdue";
                            }
                            else if (estimatedDate.HasValue && remainingDays == 0)
                            {
                                rowClass = "service-row-today";
                            }
                            else if (estimatedDate.HasValue && remainingDays == 1)
                            {
                                rowClass = "service-row-tomorrow";
                            }

                            <tr class="@rowClass">

                                <!-- SERVİS / PLAKA -->
                                <td>

                                    <div class="service-identity">

                                        <div class="service-record-icon">
                                            <i class="bi bi-car-front-fill"></i>
                                        </div>

                                        <div>

                                            <span class="plate-badge">
                                                @item.Plate
                                            </span>

                                            <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">

                                                <span class="service-record-subtitle">
                                                    Servis #@item.ServiceRecordId
                                                </span>

                                                @if (item.IsCreatedFromAppointment)
                                                {
                                                    <span class="app-badge app-badge-info">

                                                        <i class="bi bi-calendar2-check-fill"></i>

                                                        Randevudan

                                                    </span>
                                                }

                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <!-- MÜŞTERİ -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.CustomerName))
                                    {
                                        <span class="service-customer">

                                            <i class="bi bi-person-fill"></i>

                                            @item.CustomerName

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="customer-empty-value">

                                            <i class="bi bi-dash-circle"></i>

                                            Müşteri bilgisi yok

                                        </span>
                                    }

                                </td>

                                <!-- GİRİŞ TARİHİ -->
                                <td>

                                    <div class="service-date">

                                        <i class="bi bi-calendar-plus-fill"></i>

                                        <div>

                                            <strong>
                                                @item.CheckInDate.ToString("dd.MM.yyyy")
                                            </strong>

                                            <span>
                                                @item.CheckInDate.ToString("HH:mm")
                                            </span>

                                        </div>

                                    </div>

                                </td>

                                <!-- TAHMİNİ TESLİM -->
                                <td>

                                    @if (item.EstimatedDeliveryDate.HasValue &&
                                                                item.EstimatedDeliveryDate.Value.Year > 1)
                                    {
                                        <div class="delivery-cell">

                                            <div class="delivery-date-line">

                                                <i class="bi bi-calendar-event-fill"></i>

                                                <strong>
                                                    @(item.EstimatedDeliveryDate.Value.ToString("dd.MM.yyyy"))
                                                </strong>

                                                <span>
                                                    @(item.EstimatedDeliveryDate.Value.ToString("HH:mm"))
                                                </span>

                                            </div>

                                            <span class="@deliveryClass delivery-status-badge">

                                                <i class="bi @deliveryIcon"></i>

                                                @deliveryText

                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="customer-empty-value">

                                            <i class="bi bi-calendar-x"></i>

                                            Tarih belirtilmedi

                                        </span>
                                    }

                                </td>

                                <!-- SERVİS DURUMU -->
                                <td>

                                    @{
                                        var badgeClass =
                                        "app-badge app-badge-secondary";

                                        var icon =
                                        "bi-info-circle-fill";

                                        var text =
                                        "Bilinmiyor";

                                        switch (item.Status)
                                        {
                                            case AutoService.Entity.Enums.ServiceStatus.Bekliyor:

                                                badgeClass =
                                                "app-badge app-badge-warning";

                                                icon =
                                                "bi-clock-fill";

                                                text =
                                                "Bekliyor";

                                                break;

                                            case AutoService.Entity.Enums.ServiceStatus.Islemde:

                                                badgeClass =
                                                "app-badge app-badge-primary";

                                                icon =
                                                "bi-tools";

                                                text =
                                                "İşlemde";

                                                break;

                                            case AutoService.Entity.Enums.ServiceStatus.ParcaBekleniyor:

                                                badgeClass =
                                                "app-badge app-badge-warning";

                                                icon =
                                                "bi-box-seam-fill";

                                                text =
                                                "Parça Bekleniyor";

                                                break;

                                            case AutoService.Entity.Enums.ServiceStatus.Tamamlandi:

                                                badgeClass =
                                                "app-badge app-badge-success";

                                                icon =
                                                "bi-check-circle-fill";

                                                text =
                                                "Tamamlandı";

                                                break;

                                            case AutoService.Entity.Enums.ServiceStatus.IptalEdildi:

                                                badgeClass =
                                                "app-badge app-badge-danger";

                                                icon =
                                                "bi-x-octagon-fill";

                                                text =
                                                "İptal Edildi";

                                                break;
                                        }
                                    }

                                    <span class="@badgeClass service-status-badge">

                                        <i class="bi @icon"></i>

                                        @text

                                    </span>

                                </td>

                                <!-- İŞLEMLER -->
                                <td>

                                    <div class="d-flex justify-content-end align-items-center gap-2 flex-nowrap">

                                        <a asp-action="Detail"
                                           asp-route-id="@item.ServiceRecordId"
                                           class="table-action-btn action-detail"
                                           title="Servis Kaydı Detayı">

                                            <i class="bi bi-eye-fill"></i>

                                        </a>

                                        <a asp-controller="ServiceOperation"
                                           asp-action="Index"
                                           asp-route-serviceRecordId="@item.ServiceRecordId"
                                           class="table-action-btn action-detail"
                                           title="Servis İşlemleri">

                                            <i class="bi bi-wrench-adjustable-circle-fill"></i>

                                        </a>
                                        @if (canManageServices &&
                                           !item.ActualDeliveryDate.HasValue)
                                        {
                                            <button type="button"
                                                    class="table-action-btn action-success deliverBtn"
                                                    title="Aracı Müşteriye Teslim Et"
                                                    data-id="@item.ServiceRecordId"
                                                    data-plate="@item.Plate">

                                                <i class="bi bi-box-arrow-right"></i>

                                            </button>
                                        }

                                        @if (canManageServices)
                                        {
                                            <a asp-action="Update"
                                               asp-route-id="@item.ServiceRecordId"
                                               class="table-action-btn action-edit"
                                               title="Düzenle">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                            <button type="button"
                                                    class="table-action-btn action-delete deleteBtn"
                                                    title="Sil"
                                                    data-id="@item.ServiceRecordId"
                                                    data-plate="@item.Plate">

                                                <i class="bi bi-trash3-fill"></i>

                                            </button>
                                        }

                                    </div>

                                    @if (canManageServices)
                                    {
                                        <form id="delete-@item.ServiceRecordId"
                                              asp-action="Delete"
                                              asp-route-id="@item.ServiceRecordId"
                                              method="post"
                                              class="d-none">

                                            @Html.AntiForgeryToken()

                                        </form>

                                        @if (canManageServices &&
                                                                    !item.ActualDeliveryDate.HasValue)
                                        {
                                            <form id="deliver-@item.ServiceRecordId"
                                                  asp-controller="ServiceRecord"
                                                  asp-action="DeliverVehicle"
                                                  asp-route-id="@item.ServiceRecordId"
                                                  method="post"
                                                  class="d-none">

                                                @Html.AntiForgeryToken()

                                            </form>
                                        }
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="dashboard-empty-state customer-empty-state">

                <i class="bi bi-wrench-adjustable-circle"></i>

                <h6>
                    Servis kaydı bulunamadı
                </h6>

                @if (!string.IsNullOrWhiteSpace(keyword))
                {
                    <span>
                        “@keyword” aramasına uygun servis kaydı bulunamadı.
                    </span>

                    <a asp-action="Index"
                       class="btn-app-secondary mt-3">

                        <i class="bi bi-arrow-counterclockwise"></i>

                        Tüm servis kayıtlarını göster

                    </a>
                }
                else
                {
                    <span>
                        Sistemde henüz servis kaydı bulunmuyor.
                    </span>

                    @if (canManageServices)
                    {
                        <a asp-action="Create"
                           class="btn-app-primary mt-3">

                            <i class="bi bi-plus-circle-fill"></i>

                            İlk servis kaydını oluştur

                        </a>
                    }
                }

            </div>
        }

    </div>

    <!-- SAYFALAMA -->
    @if (totalPage > 1)
    {
        <div class="app-card-footer customer-pagination-footer">

            <div class="pagination-info">

                <i class="bi bi-file-earmark-text"></i>

                <span>
                    Sayfa @currentPage / @totalPage
                </span>

            </div>

            <nav aria-label="Servis kaydı sayfaları">

                <ul class="pagination app-pagination mb-0">

                    <!-- İLK SAYFA -->
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="1"
                           asp-route-keyword="@keyword"
                           title="İlk sayfa">

                            <i class="bi bi-chevron-double-left"></i>

                        </a>

                    </li>

                    <!-- ÖNCEKİ SAYFA -->
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-keyword="@keyword"
                           title="Önceki sayfa">

                            <i class="bi bi-chevron-left"></i>

                        </a>

                    </li>

                    @{
                        var startPage = Math.Max(1, currentPage - 2);
                        var endPage = Math.Min(totalPage, currentPage + 2);
                    }

                    @if (startPage > 1)
                    {
                        <li class="page-item">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="1"
                               asp-route-keyword="@keyword">
                                1
                            </a>

                        </li>

                        @if (startPage > 2)
                        {
                            <li class="page-item disabled">

                                <span class="page-link">
                                    …
                                </span>

                            </li>
                        }
                    }

                    @for (var i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-keyword="@keyword">

                                @i

                            </a>

                        </li>
                    }

                    @if (endPage < totalPage)
                    {
                        @if (endPage < totalPage - 1)
                        {
                            <li class="page-item disabled">

                                <span class="page-link">
                                    …
                                </span>

                            </li>
                        }

                        <li class="page-item">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@totalPage"
                               asp-route-keyword="@keyword">

                                @totalPage

                            </a>

                        </li>
                    }

                    <!-- SONRAKİ SAYFA -->
                    <li class="page-item @(currentPage >= totalPage ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-keyword="@keyword"
                           title="Sonraki sayfa">

                            <i class="bi bi-chevron-right"></i>

                        </a>

                    </li>

                    <!-- SON SAYFA -->
                    <li class="page-item @(currentPage >= totalPage ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@totalPage"
                           asp-route-keyword="@keyword"
                           title="Son sayfa">

                            <i class="bi bi-chevron-double-right"></i>

                        </a>

                    </li>

                </ul>

            </nav>

        </div>
    }

</div>

@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const deleteButtons =
                document.querySelectorAll(".deleteBtn");

            deleteButtons.forEach(function (button) {

                button.addEventListener("click", function () {

                    const id = this.dataset.id;
                    const plate = this.dataset.plate;

                    Swal.fire({

                        title: "Servis kaydı silinsin mi?",

                        html:
                            "<strong>" +
                            escapeHtml(plate) +
                            "</strong> plakalı aracın servis kaydı silinecek.<br>" +
                            "<small>Bu işlem geri alınamaz.</small>",

                        icon: "warning",

                        showCancelButton: true,

                        reverseButtons: true,

                        focusCancel: true,

                        confirmButtonColor: "#dc2626",

                        cancelButtonColor: "#64748b",

                        confirmButtonText:
                            '<i class="bi bi-trash3-fill me-1"></i> Evet, sil',

                        cancelButtonText:
                            '<i class="bi bi-x-circle me-1"></i> İptal'

                    }).then(function (result) {

                        if (result.isConfirmed) {

                            const form =
                                document.getElementById(
                                    "delete-" + id
                                );

                            if (form) {
                                form.submit();
                            }

                        }

                    });

                });

            });

            const deliverButtons =
                document.querySelectorAll(".deliverBtn");

            deliverButtons.forEach(function (button) {

                button.addEventListener("click", function () {

                    const id =
                        this.dataset.id;

                    const plate =
                        this.dataset.plate;

                    Swal.fire({

                        title: "Araç teslim edilsin mi?",

                        html:
                            "<strong>" +
                            escapeHtml(plate) +
                            "</strong> plakalı araç müşteriye teslim edilecek.<br>" +
                            "<small>Gerçek teslim tarihi şu anki tarih ve saat olarak kaydedilecektir.</small>",

                        icon: "question",

                        showCancelButton: true,

                        reverseButtons: true,

                        focusCancel: true,

                        confirmButtonColor: "#16a34a",

                        cancelButtonColor: "#64748b",

                        confirmButtonText:
                            '<i class="bi bi-check-circle-fill me-1"></i> Evet, teslim et',

                        cancelButtonText:
                            '<i class="bi bi-x-circle me-1"></i> Vazgeç'

                    }).then(function (result) {

                        if (result.isConfirmed) {

                            const form =
                                document.getElementById(
                                    "deliver-" + id
                                );

                            if (form) {
                                form.submit();
                            }

                        }

                    });

                });

            });

        });

        function escapeHtml(value) {

            const element =
                document.createElement("div");

            element.textContent = value || "";

            return element.innerHTML;

        }

    </script>
}