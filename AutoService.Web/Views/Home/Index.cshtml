    <!-- Son Aktiviteler -->
    <div class="col-xl-7">

        <div class="app-card h-100">

            <div class="app-card-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="chart-header-icon icon-success">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    <div class="app-card-title">

                        <h5>
                            Son Aktiviteler
                        </h5>

                        <span>
                            Sistemde gerçekleştirilen son işlemler
                        </span>

                    </div>

                </div>

            </div>

            <div class="app-card-body">

                @if (Model.RecentActivities != null &&
                                Model.RecentActivities.Any())
                {
                    <div class="activity-timeline">

                        @foreach (var item in Model.RecentActivities)
                        {
                            var activityClass =
                            item.ActivityType switch
                            {
                                "Customer" => "activity-blue",
                                "Vehicle" => "activity-green",
                                "Service" => "activity-orange",
                                "SparePart" => "activity-purple",
                                _ => "activity-gray"
                            };

                            var activityIcon =
                            item.ActivityType switch
                            {
                                "Customer" => "bi-person-plus-fill",
                                "Vehicle" => "bi-car-front-fill",
