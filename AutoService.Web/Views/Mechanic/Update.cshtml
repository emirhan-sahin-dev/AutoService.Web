@model AutoService.Dto.MechanicDtos.UpdateMechanicDto

@{
    ViewData["Title"] = "Usta Güncelle";
}

<div class="page-header">

    <div>

        <div class="page-header-label">
            <i class="bi bi-pencil-square"></i>
            Usta Yönetimi
        </div>

        <h1>Usta Bilgilerini Güncelle</h1>

        <p>
            Kayıtlı ustanın iletişim ve mesleki bilgilerini düzenleyin.
        </p>

    </div>

    <a asp-action="Index"
       class="btn-app-secondary">

        <i class="bi bi-arrow-left"></i>
        Usta Listesi

    </a>

</div>

<div class="row g-4">

    <div class="col-xl-8">

        <div class="app-card">

            <div class="app-card-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="chart-header-icon icon-warning">
                        <i class="bi bi-person-gear"></i>
                    </div>

                    <div class="app-card-title">

                        <h5>Usta Bilgilerini Düzenle</h5>

                        <span>
                            Personel kaydındaki mevcut bilgileri güncelleyin
                        </span>

                    </div>

                </div>

                <span class="app-badge app-badge-warning">

                    <i class="bi bi-hash"></i>
                    @Model.MechanicId

                </span>

            </div>

            <div class="app-card-body">

                <form asp-action="Update"
                      method="post"
                      class="app-form">

                    <input asp-for="MechanicId"
                           type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="mechanic-form-visual mechanic-form-warning">

                        <div class="mechanic-form-avatar">
                            <i class="bi bi-pencil-square"></i>
                        </div>

                        <div>

                            <strong>Personel kaydı güncelleniyor</strong>

                            <span>
                                Yapılan değişiklikler mevcut servis atamalarında
                                ve personel bilgilerinde görüntülenecektir.
                            </span>

                        </div>

                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <div class="app-form-group">

                                <label asp-for="FirstName"
                                       class="app-form-label">

                                    <i class="bi bi-person-fill"></i>
                                    Ad
                                    <span>*</span>

                                </label>

                                <div class="app-input-wrapper">

                                    <i class="bi bi-person"></i>

                                    <input asp-for="FirstName"
                                           class="app-form-control"
                                           autocomplete="off" />

                                </div>

                                <span asp-validation-for="FirstName"
                                      class="app-validation-message">
                                </span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="app-form-group">

                                <label asp-for="LastName"
                                       class="app-form-label">

                                    <i class="bi bi-person-badge-fill"></i>
                                    Soyad
                                    <span>*</span>

                                </label>

                                <div class="app-input-wrapper">

                                    <i class="bi bi-person-badge"></i>

                                    <input asp-for="LastName"
                                           class="app-form-control"
                                           autocomplete="off" />

                                </div>

                                <span asp-validation-for="LastName"
                                      class="app-validation-message">
                                </span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="app-form-group">

                                <label asp-for="Phone"
                                       class="app-form-label">

                                    <i class="bi bi-telephone-fill"></i>
                                    Telefon
                                    <span>*</span>

                                </label>

                                <div class="app-input-wrapper">

                                    <i class="bi bi-telephone"></i>

                                    <input asp-for="Phone"
                                           type="tel"
                                           class="app-form-control"
                                           autocomplete="tel" />

                                </div>

                                <span asp-validation-for="Phone"
                                      class="app-validation-message">
                                </span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="app-form-group">

                                <label asp-for="Email"
                                       class="app-form-label">

                                    <i class="bi bi-envelope-fill"></i>
                                    E-posta
                                    <span>*</span>

                                </label>

                                <div class="app-input-wrapper">

                                    <i class="bi bi-envelope"></i>

                                    <input asp-for="Email"
                                           type="email"
                                           class="app-form-control"
                                           autocomplete="email" />

                                </div>

                                <span asp-validation-for="Email"
                                      class="app-validation-message">
                                </span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="app-form-group">

                                <label asp-for="Specialty"
                                       class="app-form-label">

                                    <i class="bi bi-tools"></i>
                                    Uzmanlık Alanı
                                    <span>*</span>

                                </label>

                                <div class="app-input-wrapper">

                                    <i class="bi bi-wrench-adjustable"></i>

                                    <input asp-for="Specialty"
                                           class="app-form-control"
                                           autocomplete="off" />

                                </div>

                                <span asp-validation-for="Specialty"
                                      class="app-validation-message">
                                </span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="app-form-group">

                                <label asp-for="HireDate"
                                       class="app-form-label">

                                    <i class="bi bi-calendar-check-fill"></i>
                                    İşe Giriş Tarihi
                                    <span>*</span>

                                </label>

                                <div class="app-input-wrapper">

                                    <i class="bi bi-calendar3"></i>

                                    <input asp-for="HireDate"
                                           type="date"
                                           class="app-form-control" />

                                </div>

                                <span asp-validation-for="HireDate"
                                      class="app-validation-message">
                                </span>

                            </div>

                        </div>

                    </div>

                    <div class="app-form-actions">

                        <a asp-action="Index"
                           class="btn-app-secondary">

                            <i class="bi bi-x-circle"></i>
                            Vazgeç

                        </a>

                        <button type="submit"
                                class="btn-app-warning">

                            <i class="bi bi-check-circle-fill"></i>
                            Değişiklikleri Kaydet

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <div class="col-xl-4">

        <div class="app-card form-info-card form-info-warning">

            <div class="form-info-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <h5>Güncelleme Bilgisi</h5>

            <p>
                Personel bilgilerindeki değişiklikler sistem genelindeki
                usta kayıtlarına yansıyacaktır.
            </p>

            <ul class="form-info-list">

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    İletişim bilgilerini doğrulayın
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Uzmanlık alanını güncel tutun
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    İşe giriş tarihini değiştirmeden kontrol edin
                </li>

            </ul>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}