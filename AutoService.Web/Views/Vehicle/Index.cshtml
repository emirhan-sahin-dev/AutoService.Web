@using AutoService.Web.Security
@model List<AutoService.Dto.VehicleDtos.ResultVehicleDto>

@{
    ViewData["Title"] = "Araçlar";

    var keyword = ViewBag.Keyword as string;

    var currentPage = ViewBag.CurrentPage != null
        ? Convert.ToInt32(ViewBag.CurrentPage)
        : 1;

    var totalPage = ViewBag.TotalPage != null
        ? Convert.ToInt32(ViewBag.TotalPage)
        : 1;

    var totalCount = ViewBag.TotalCount != null
        ? Convert.ToInt32(ViewBag.TotalCount)
        : Model.Count;

    var brandCount = Model
        .Where(x => !string.IsNullOrWhiteSpace(x.BrandName))
        .Select(x => x.BrandName)
        .Distinct()
        .Count();

    var customerCount = Model
        .Where(x => !string.IsNullOrWhiteSpace(x.CustomerName))
        .Select(x => x.CustomerName)
        .Distinct()
        .Count();

    var canManageVehicles =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.ServiceAdvisor);
}

<!-- SAYFA BAŞLIĞI -->
<div class="page-header">

    <div>

        <div class="page-header-label">
            <i class="bi bi-car-front-fill"></i>
            Araç Yönetimi
        </div>

        <h1>Araçlar</h1>

        <p>
            Sistemde kayıtlı araçları görüntüleyin, arayın ve yönetin.
        </p>

    </div>

    @if (canManageVehicles)
    {
        <a asp-action="Create"
           class="btn-app-primary">

            <i class="bi bi-plus-circle-fill"></i>

            Yeni Araç

        </a>
    }

</div>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4"
         role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Kapat">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4"
         role="alert">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Kapat">
        </button>

    </div>
}
<!-- ÖZET KARTLARI -->
<div class="row g-4 mb-4">

    <div class="col-xl-4 col-md-6">

        <div class="dashboard-alert dashboard-alert-primary">

            <div class="dashboard-alert-icon icon-primary">
                <i class="bi bi-car-front-fill"></i>
            </div>

            <div class="dashboard-alert-content">

                <strong>
                    @totalCount
                </strong>

                <span>
                    Arama sonucundaki toplam araç
                </span>

            </div>

        </div>

    </div>

    <div class="col-xl-4 col-md-6">

        <div class="dashboard-alert dashboard-alert-success">

            <div class="dashboard-alert-icon icon-success">
                <i class="bi bi-tags-fill"></i>
            </div>

            <div class="dashboard-alert-content">

                <strong>@brandCount</strong>

                <span>
                    Bu sayfadaki farklı marka
                </span>

            </div>

        </div>

    </div>

    <div class="col-xl-4 col-md-12">

        <div class="dashboard-alert dashboard-alert-warning">

            <div class="dashboard-alert-icon icon-warning">
                <i class="bi bi-people-fill"></i>
            </div>

            <div class="dashboard-alert-content">

                <strong>@customerCount</strong>

                <span>
                    Bu sayfadaki araç sahibi
                </span>

            </div>

        </div>

    </div>

</div>

<!-- ARAÇ LİSTESİ -->
<div class="app-card">

    <div class="app-card-header">

        <div class="d-flex align-items-center gap-3">

            <div class="chart-header-icon icon-primary">
                <i class="bi bi-list-check"></i>
            </div>

            <div class="app-card-title">

                <h5>
                    Araç Listesi
                </h5>

                <span>
                    Plaka, marka, model veya müşteri adına göre arama yapın
                </span>

            </div>

        </div>

        <span class="app-badge app-badge-primary">

            <i class="bi bi-database"></i>

            @totalCount kayıt

        </span>

    </div>

    <!-- ARAMA -->
    <div class="app-card-body">

        <form method="get"
              asp-action="Index"
              class="customer-filter-form">

            <div class="customer-search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       name="keyword"
                       value="@keyword"
                       placeholder="Plaka, marka, model veya müşteri ara..."
                       autocomplete="off" />

            </div>

            <button type="submit"
                    class="btn-app-primary">

                <i class="bi bi-search"></i>

                Ara

            </button>

            @if (!string.IsNullOrWhiteSpace(keyword))
            {
                <a asp-action="Index"
                   class="btn-app-secondary">

                    <i class="bi bi-x-circle"></i>

                    Temizle

                </a>
            }

        </form>

    </div>

    <!-- TABLO -->
    <div class="app-card-body p-0">

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table app-table align-middle mb-0">

                    <thead>

                        <tr>

                            <th>
                                Araç
                            </th>

                            <th>
                                Marka
                            </th>

                            <th>
                                Model
                            </th>

                            <th>
                                Müşteri
                            </th>

                            <th>
                                Kayıt No
                            </th>

                            <th class="text-end">
                                İşlemler
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <div class="vehicle-identity">

                                        <div class="vehicle-icon">
                                            <i class="bi bi-car-front-fill"></i>
                                        </div>

                                        <div>

                                            <span class="plate-badge">
                                                @item.Plate
                                            </span>

                                            <span class="vehicle-subtitle">
                                                Kayıtlı araç
                                            </span>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.BrandName))
                                    {
                                        <span class="vehicle-info-value">

                                            <i class="bi bi-tag-fill"></i>

                                            @item.BrandName

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="customer-empty-value">
                                            <i class="bi bi-dash-circle"></i>
                                            Marka yok
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.ModelName))
                                    {
                                        <span class="vehicle-model-badge">
                                            @item.ModelName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="customer-empty-value">
                                            <i class="bi bi-dash-circle"></i>
                                            Model yok
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.CustomerName))
                                    {
                                        <span class="vehicle-info-value">

                                            <i class="bi bi-person-fill"></i>

                                            @item.CustomerName

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="customer-empty-value">
                                            <i class="bi bi-dash-circle"></i>
                                            Müşteri yok
                                        </span>
                                    }

                                </td>

                                <td>

                                    <span class="customer-id-badge">
                                        #@item.VehicleId
                                    </span>

                                </td>

                                <td>

                                    <div class="table-actions justify-content-end">

                                        <a asp-action="Detail"
                                           asp-route-id="@item.VehicleId"
                                           class="table-action-btn action-detail"
                                           title="Detay">

                                            <i class="bi bi-eye-fill"></i>

                                        </a>

                                        @if (canManageVehicles)
                                        {
                                            <a asp-action="Update"
                                               asp-route-id="@item.VehicleId"
                                               class="table-action-btn action-edit"
                                               title="Düzenle">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                            <button type="button"
                                                    class="table-action-btn action-delete deleteBtn"
                                                    title="Sil"
                                                    data-id="@item.VehicleId"
                                                    data-plate="@item.Plate">

                                                <i class="bi bi-trash3-fill"></i>

                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="dashboard-empty-state customer-empty-state">

                <i class="bi bi-car-front"></i>

                <h6>
                    Araç bulunamadı
                </h6>

                @if (!string.IsNullOrWhiteSpace(keyword))
                {
                    <span>
                        “@keyword” aramasına uygun araç kaydı bulunamadı.
                    </span>

                    <a asp-action="Index"
                       class="btn-app-secondary mt-3">

                        <i class="bi bi-arrow-counterclockwise"></i>

                        Tüm araçları göster

                    </a>
                }
                else
                {
                    <span>
                        Sistemde henüz kayıtlı araç bulunmuyor.
                    </span>

                    @if (canManageVehicles)
                    {
                        <a asp-action="Create"
                           class="btn-app-primary mt-3">

                            <i class="bi bi-plus-circle-fill"></i>

                            İlk aracı ekle

                        </a>
                    }
                }

            </div>
        }

    </div>

    <!-- SAYFALAMA -->
    @if (totalPage > 1)
    {
        <div class="app-card-footer customer-pagination-footer">

            <div class="pagination-info">

                <i class="bi bi-file-earmark-text"></i>

                <span>
                    Sayfa @currentPage / @totalPage
                </span>

            </div>

            <nav aria-label="Araç sayfaları">

                <ul class="pagination app-pagination mb-0">

                    <!-- İLK SAYFA -->
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="1"
                           asp-route-keyword="@keyword"
                           title="İlk sayfa">

                            <i class="bi bi-chevron-double-left"></i>

                        </a>

                    </li>

                    <!-- ÖNCEKİ -->
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-keyword="@keyword"
                           title="Önceki sayfa">

                            <i class="bi bi-chevron-left"></i>

                        </a>

                    </li>

                    @{
                        var startPage = Math.Max(1, currentPage - 2);
                        var endPage = Math.Min(totalPage, currentPage + 2);
                    }

                    @if (startPage > 1)
                    {
                        <li class="page-item">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="1"
                               asp-route-keyword="@keyword">
                                1
                            </a>

                        </li>

                        @if (startPage > 2)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">…</span>
                            </li>
                        }
                    }

                    @for (var i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-keyword="@keyword">
                                @i
                            </a>

                        </li>
                    }

                    @if (endPage < totalPage)
                    {
                        @if (endPage < totalPage - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">…</span>
                            </li>
                        }

                        <li class="page-item">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@totalPage"
                               asp-route-keyword="@keyword">
                                @totalPage
                            </a>

                        </li>
                    }

                    <!-- SONRAKİ -->
                    <li class="page-item @(currentPage >= totalPage ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-keyword="@keyword"
                           title="Sonraki sayfa">

                            <i class="bi bi-chevron-right"></i>

                        </a>

                    </li>

                    <!-- SON SAYFA -->
                    <li class="page-item @(currentPage >= totalPage ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@totalPage"
                           asp-route-keyword="@keyword"
                           title="Son sayfa">

                            <i class="bi bi-chevron-double-right"></i>

                        </a>

                    </li>

                </ul>

            </nav>

        </div>
    }

</div>

@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const deleteButtons =
                document.querySelectorAll(".deleteBtn");

            deleteButtons.forEach(function (button) {

                button.addEventListener("click", function () {

                    const id = this.dataset.id;
                    const plate = this.dataset.plate;

                    Swal.fire({

                        title: "Araç silinsin mi?",

                        html:
                            "<strong>" +
                            escapeHtml(plate) +
                            "</strong> plakalı araç silinecek.<br>" +
                            "<small>Bu işlem sonrasında araç listeden kaldırılacaktır.</small>",

                        icon: "warning",

                        showCancelButton: true,

                        reverseButtons: true,

                        focusCancel: true,

                        confirmButtonColor: "#dc2626",

                        cancelButtonColor: "#64748b",

                        confirmButtonText:
                            '<i class="bi bi-trash3-fill me-1"></i> Evet, sil',

                        cancelButtonText:
                            '<i class="bi bi-x-circle me-1"></i> İptal'

                    }).then(function (result) {

                        if (result.isConfirmed) {

                            window.location.href =
                                "/Vehicle/Delete/" +
                                encodeURIComponent(id);

                        }

                    });

                });

            });

        });

        function escapeHtml(value) {

            const element =
                document.createElement("div");

            element.textContent = value || "";

            return element.innerHTML;

        }

    </script>
}