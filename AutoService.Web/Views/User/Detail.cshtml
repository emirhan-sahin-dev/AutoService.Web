@model AutoService.Dto.UserDtos.GetByIdUserDto

@{
    ViewData["Title"] = "Kullanıcı Detayı";

    var initials = "K";

    if (!string.IsNullOrWhiteSpace(Model.FullName))
    {
        initials = string.Join(
            string.Empty,
            Model.FullName
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(x => x[0])
        ).ToUpper();
    }
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-xl-9">

            <div class="card shadow border-0 rounded-4">

                <div class="card-header bg-primary text-white">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h3 class="mb-1">
                                <i class="bi bi-person-vcard-fill"></i>
                                Kullanıcı Detayı
                            </h3>

                            <small>
                                Kullanıcı hesabı bilgileri
                            </small>

                        </div>

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success fs-6">
                                Aktif
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">
                                Pasif
                            </span>
                        }

                    </div>

                </div>

                <div class="card-body p-5">

                    <div class="row">

                        <div class="col-lg-4">

                            <div class="text-center">

                                <div class="rounded-circle bg-primary text-white mx-auto d-flex justify-content-center align-items-center shadow"
                                     style="width:120px;height:120px;font-size:40px;font-weight:bold;">

                                    @initials

                                </div>

                                <h4 class="mt-4 mb-1">

                                    @Model.FullName

                                </h4>

                                <p class="text-muted">

                                    @Model.Email

                                </p>

                                <span class="badge bg-primary px-3 py-2">

                                    @Model.RoleName

                                </span>

                            </div>

                        </div>

                        <div class="col-lg-8">

                            <table class="table table-bordered align-middle">

                                <tbody>

                                    <tr>

                                        <th width="220">
                                            Kullanıcı ID
                                        </th>

                                        <td>
                                            @Model.UserId
                                        </td>

                                    </tr>

                                    <tr>

                                        <th>
                                            Ad Soyad
                                        </th>

                                        <td>
                                            @Model.FullName
                                        </td>

                                    </tr>

                                    <tr>

                                        <th>
                                            Kullanıcı Adı
                                        </th>

                                        <td>
                                            @Model.Username
                                        </td>

                                    </tr>

                                    <tr>

                                        <th>
                                            E-Posta
                                        </th>

                                        <td>
                                            @Model.Email
                                        </td>

                                    </tr>

                                    <tr>

                                        <th>
                                            Rol
                                        </th>

                                        <td>

                                            <span class="badge bg-primary">

                                                @Model.RoleName

                                            </span>

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>
                                            Durum
                                        </th>

                                        <td>

                                            @if (Model.IsActive)
                                            {
                                                <span class="badge bg-success">
                                                    Aktif
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    Pasif
                                                </span>
                                            }

                                        </td>

                                    </tr>

                                    <tr>

                                        <th>
                                            Oluşturulma Tarihi
                                        </th>

                                        <td>

                                            @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")

                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            <i class="bi bi-arrow-left"></i>

                            Listeye Dön

                        </a>

                        <a asp-action="Update"
                           asp-route-id="@Model.UserId"
                           class="btn btn-warning">

                            <i class="bi bi-pencil-square"></i>

                            Düzenle

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>