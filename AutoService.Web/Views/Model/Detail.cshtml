@model AutoService.Dto.ModelDtos.GetByIdModelDto

@{
    ViewData["Title"] = "Model Detayı";
}

<div class="container-fluid">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm border-0 rounded-4">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h3 class="fw-bold">
                        Model Detayı
                    </h3>

                </div>

                <div class="card-body px-4 pb-4">

                    <div class="row mb-3">

                        <div class="col-sm-4 fw-semibold">
                            Model ID
                        </div>

                        <div class="col-sm-8">
                            @Model.ModelId
                        </div>

                    </div>

                    <div class="row mb-3">

                        <div class="col-sm-4 fw-semibold">
                            Marka
                        </div>

                        <div class="col-sm-8">
                            @ViewBag.BrandName
                        </div>

                    </div>

                    <div class="row mb-4">

                        <div class="col-sm-4 fw-semibold">
                            Model Adı
                        </div>

                        <div class="col-sm-8">
                            @Model.ModelName
                        </div>

                    </div>

                    <a asp-action="Update"
                       asp-route-id="@Model.ModelId"
                       class="btn btn-warning">

                        Güncelle

                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Listeye Dön

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>