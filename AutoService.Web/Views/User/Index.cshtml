@using AutoService.Web.Security
@model AutoService.Dto.CommonDtos.PagedResultDto<AutoService.Dto.UserDtos.ResultUserDto>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";

    var keyword = ViewBag.Keyword as string;
}

<div class="page-header">

    <div>

        <div class="page-header-label">
            <i class="bi bi-people-fill"></i>
            Sistem Yönetimi
        </div>

        <h1>Kullanıcı Yönetimi</h1>

        <p>
            Sistem kullanıcılarını, rollerini ve hesap durumlarını yönetin.
        </p>

    </div>

    <a asp-action="Create"
       class="btn-app-primary">

        <i class="bi bi-person-plus-fill"></i>
        Yeni Kullanıcı

    </a>

</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="row g-4 mb-4">

    <div class="col-xl-4 col-md-6">

        <div class="dashboard-alert dashboard-alert-primary">

            <div class="dashboard-alert-icon icon-primary">

                <i class="bi bi-people-fill"></i>

            </div>

            <div class="dashboard-alert-content">

                <strong>@Model.TotalCount</strong>

                <span>Toplam kullanıcı</span>

            </div>

        </div>

    </div>

    <div class="col-xl-4 col-md-6">

        <div class="dashboard-alert dashboard-alert-success">

            <div class="dashboard-alert-icon icon-success">

                <i class="bi bi-person-check-fill"></i>

            </div>

            <div class="dashboard-alert-content">

                <strong>
                    @Model.Items.Count(x => x.IsActive)
                </strong>

                <span>Bu sayfadaki aktif kullanıcı</span>

            </div>

        </div>

    </div>

    <div class="col-xl-4 col-md-12">

        <div class="dashboard-alert dashboard-alert-warning">

            <div class="dashboard-alert-icon icon-warning">

                <i class="bi bi-person-dash-fill"></i>

            </div>

            <div class="dashboard-alert-content">

                <strong>
                    @Model.Items.Count(x => !x.IsActive)
                </strong>

                <span>Bu sayfadaki pasif kullanıcı</span>

            </div>

        </div>

    </div>

</div>

<div class="app-card">

    <div class="app-card-header">

        <div class="d-flex align-items-center gap-3">

            <div class="chart-header-icon icon-primary">

                <i class="bi bi-person-lines-fill"></i>

            </div>

            <div class="app-card-title">

                <h5>Kullanıcı Listesi</h5>

                <span>
                    Kullanıcı hesaplarını görüntüleyin ve yönetin
                </span>

            </div>

        </div>

        <span class="app-badge app-badge-primary">

            <i class="bi bi-database"></i>

            @Model.TotalCount kayıt

        </span>

    </div>

    <div class="app-card-body">

        <form method="get"
              asp-action="Index"
              class="customer-filter-form">

            <div class="customer-search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       name="keyword"
                       value="@keyword"
                       placeholder="Ad, kullanıcı adı, e-posta veya rol ara..."
                       autocomplete="off" />

            </div>

            <input type="hidden"
                   name="pageSize"
                   value="@Model.PageSize" />

            <button type="submit"
                    class="btn-app-primary">

                <i class="bi bi-search"></i>
                Ara

            </button>

            @if (!string.IsNullOrWhiteSpace(keyword))
            {
                <a asp-action="Index"
                   asp-route-pageSize="@Model.PageSize"
                   class="btn-app-secondary">

                    <i class="bi bi-x-circle"></i>
                    Temizle

                </a>
            }

        </form>

    </div>

    <div class="app-card-body p-0">

        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="table-responsive">

                <table class="table app-table align-middle mb-0">

                    <thead>

                        <tr>

                            <th>Kullanıcı</th>

                            <th>Kullanıcı Adı</th>

                            <th>Rol</th>

                            <th>Durum</th>

                            <th>Kayıt Tarihi</th>

                            <th class="text-end">
                                İşlemler
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            var initials = string.Empty;

                            if (!string.IsNullOrWhiteSpace(item.FullName))
                            {
                                initials = string.Join(
                                string.Empty,
                                item.FullName
                                .Split(
                                ' ',
                                StringSplitOptions.RemoveEmptyEntries
                                )
                                .Take(2)
                                .Select(x => x[0])
                                ).ToUpper();
                            }

                            if (string.IsNullOrWhiteSpace(initials))
                            {
                                initials = "K";
                            }

                            <tr>

                                <td>

                                    <div class="customer-identity">

                                        <div class="customer-avatar">

                                            @initials

                                        </div>

                                        <div>

                                            <div class="customer-name">

                                                @item.FullName

                                            </div>

                                            <span class="customer-subtitle">

                                                @item.Email

                                            </span>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    <span class="customer-id-badge">

                                        @item.Username

                                    </span>

                                </td>

                                <td>

                                    <span class="app-badge app-badge-primary">

                                        <i class="bi bi-shield-check"></i>

                                        @item.RoleName

                                    </span>

                                </td>

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="app-badge app-badge-success">

                                            <i class="bi bi-check-circle-fill"></i>

                                            Aktif

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="app-badge app-badge-danger">

                                            <i class="bi bi-x-circle-fill"></i>

                                            Pasif

                                        </span>
                                    }

                                </td>

                                <td>

                                    @item.CreatedDate.ToString("dd.MM.yyyy")

                                </td>

                                <td>

                                    <div class="table-actions justify-content-end">

                                        <a asp-action="Detail"
                                           asp-route-id="@item.UserId"
                                           class="table-action-btn action-detail"
                                           title="Detay">

                                            <i class="bi bi-eye-fill"></i>

                                        </a>

                                        <a asp-action="Update"
                                           asp-route-id="@item.UserId"
                                           class="table-action-btn action-edit"
                                           title="Düzenle">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                        <a asp-action="ChangePassword"
                                           asp-route-id="@item.UserId"
                                           class="table-action-btn action-warning"
                                           title="Şifre Değiştir">

                                            <i class="bi bi-key-fill"></i>

                                        </a>

                                        <form asp-action="ToggleStatus"
                                              asp-route-id="@item.UserId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="table-action-btn @(item.IsActive ? "action-warning" : "action-success")"
                                                    title="@(item.IsActive ? "Pasif Yap" : "Aktif Yap")">

                                                <i class="bi @(item.IsActive ? "bi-person-dash-fill" : "bi-person-check-fill")"></i>

                                            </button>

                                        </form>

                                        <button type="button"
                                                class="table-action-btn action-delete deleteBtn"
                                                data-id="@item.UserId"
                                                data-name="@item.FullName"
                                                title="Sil">

                                            <i class="bi bi-trash3-fill"></i>

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="dashboard-empty-state">

                <i class="bi bi-person-x-fill"></i>

                <h6>Kullanıcı bulunamadı</h6>

                <span>

                    @if (!string.IsNullOrWhiteSpace(keyword))
                    {
                        <text>
                            Arama kriterine uygun kullanıcı kaydı bulunamadı.
                        </text>
                    }
                    else
                    {
                        <text>
                            Sistemde kayıtlı kullanıcı bulunamadı.
                        </text>
                    }

                </span>

            </div>
        }

    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="app-card-body border-top">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div class="text-muted small">

                    Toplam <strong>@Model.TotalCount</strong> kayıt

                    <span class="mx-1">•</span>

                    Sayfa <strong>@Model.CurrentPage</strong> /
                    <strong>@Model.TotalPages</strong>

                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Kullanıcı sayfalama">

                        <ul class="pagination mb-0">

                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">

                                @if (Model.HasPreviousPage)
                                {
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@(Model.CurrentPage - 1)"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-keyword="@keyword">

                                        <i class="bi bi-chevron-left"></i>
                                        Önceki

                                    </a>
                                }
                                else
                                {
                                    <span class="page-link">

                                        <i class="bi bi-chevron-left"></i>
                                        Önceki

                                    </span>
                                }

                            </li>

                            @{
                                var startPage = Math.Max(
                                1,
                                Model.CurrentPage - 2
                                );

                                var endPage = Math.Min(
                                Model.TotalPages,
                                Model.CurrentPage + 2
                                );
                            }

                            @if (startPage > 1)
                            {
                                <li class="page-item">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="1"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-keyword="@keyword">

                                        1

                                    </a>

                                </li>

                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled">

                                        <span class="page-link">
                                            ...
                                        </span>

                                    </li>
                                }
                            }

                            @for (var pageNumber = startPage;
                                                pageNumber <= endPage;
                                                pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">

                                    @if (pageNumber == Model.CurrentPage)
                                    {
                                        <span class="page-link">

                                            @pageNumber

                                        </span>
                                    }
                                    else
                                    {
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-page="@pageNumber"
                                           asp-route-pageSize="@Model.PageSize"
                                           asp-route-keyword="@keyword">

                                            @pageNumber

                                        </a>
                                    }

                                </li>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                @if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled">

                                        <span class="page-link">
                                            ...
                                        </span>

                                    </li>
                                }

                                <li class="page-item">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@Model.TotalPages"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-keyword="@keyword">

                                        @Model.TotalPages

                                    </a>

                                </li>
                            }

                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">

                                @if (Model.HasNextPage)
                                {
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@(Model.CurrentPage + 1)"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-keyword="@keyword">

                                        Sonraki
                                        <i class="bi bi-chevron-right"></i>

                                    </a>
                                }
                                else
                                {
                                    <span class="page-link">

                                        Sonraki
                                        <i class="bi bi-chevron-right"></i>

                                    </span>
                                }

                            </li>

                        </ul>

                    </nav>
                }

            </div>

        </div>
    }

</div>

<form id="deleteForm"
      asp-action="Delete"
      method="post"
      class="d-none">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="id"
           id="deleteUserId" />

</form>

@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const deleteButtons =
                document.querySelectorAll(".deleteBtn");

            const deleteForm =
                document.getElementById("deleteForm");

            const deleteUserId =
                document.getElementById("deleteUserId");

            if (!deleteForm || !deleteUserId) {
                return;
            }

            deleteButtons.forEach(function (button) {

                button.addEventListener("click", function () {

                    const id = this.dataset.id;
                    const name = this.dataset.name;

                    Swal.fire({

                        title: "Kullanıcı silinsin mi?",

                        html:
                            "<strong>" +
                            escapeHtml(name) +
                            "</strong> adlı kullanıcı silinecek.",

                        icon: "warning",

                        showCancelButton: true,

                        reverseButtons: true,

                        focusCancel: true,

                        confirmButtonColor: "#dc2626",

                        cancelButtonColor: "#64748b",

                        confirmButtonText:
                            '<i class="bi bi-trash3-fill me-1"></i> Evet, sil',

                        cancelButtonText:
                            '<i class="bi bi-x-circle me-1"></i> İptal'

                    }).then(function (result) {

                        if (result.isConfirmed) {

                            deleteUserId.value = id;

                            deleteForm.submit();

                        }

                    });

                });

            });

        });

        function escapeHtml(value) {

            const element =
                document.createElement("div");

            element.textContent = value || "";

            return element.innerHTML;

        }

    </script>
}