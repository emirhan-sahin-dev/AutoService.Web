@model AutoService.Dto.ServiceRecordDtos.CreateServiceRecordDto
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Yeni Servis Kaydı";
}

<div class="page-header">
    <div>
        <div class="page-header-label">
            <i class="bi bi-wrench-adjustable-circle-fill"></i>
            Servis Yönetimi
        </div>
        <h1>Yeni Servis Kaydı</h1>
        <p>Aracın servis ve kabul bilgilerini eksiksiz oluşturun.</p>
    </div>

    <a asp-action="Index" class="btn-app-secondary">
        <i class="bi bi-arrow-left"></i>
        Servis Listesi
    </a>
</div>

<div class="row g-4">
    <div class="col-xl-9">
        <div class="app-card">
            <div class="app-card-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="chart-header-icon icon-primary">
                        <i class="bi bi-clipboard2-plus-fill"></i>
                    </div>
                    <div class="app-card-title">
                        <h5>Servis Bilgileri</h5>
                        <span>Araç, tarih, şikâyet ve kabul bilgilerini girin</span>
                    </div>
                </div>
            </div>

            <div class="app-card-body">
                <form asp-action="Create" method="post" class="app-form">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="service-form-section">
                        <div class="service-form-section-header">
                            <div class="service-form-section-icon icon-primary">
                                <i class="bi bi-car-front-fill"></i>
                            </div>
                            <div>
                                <h6>Araç Bilgisi</h6>
                                <span>Servise alınan aracı seçin</span>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-12">
                                <div class="app-form-group">
                                    <label asp-for="VehicleId" class="app-form-label">
                                        <i class="bi bi-car-front-fill"></i>
                                        Araç <span>*</span>
                                    </label>

                                    <div class="app-select-wrapper">
                                        <i class="bi bi-car-front"></i>
                                        <select asp-for="VehicleId"
                                                asp-items="ViewBag.Vehicles"
                                                class="app-form-control app-form-select">
                                            <option value="">Araç seçiniz</option>
                                        </select>
                                    </div>

                                    <span asp-validation-for="VehicleId" class="app-validation-message"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="service-form-section">
                        <div class="service-form-section-header">
                            <div class="service-form-section-icon icon-warning">
                                <i class="bi bi-calendar-check-fill"></i>
                            </div>
                            <div>
                                <h6>Tarih ve Kilometre</h6>
                                <span>Servis giriş, tahmini teslim ve kilometre bilgileri</span>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-4">
                                <div class="app-form-group">
                                    <label asp-for="CheckInDate" class="app-form-label">
                                        <i class="bi bi-calendar-plus-fill"></i>
                                        Giriş Tarihi <span>*</span>
                                    </label>
                                    <div class="app-input-wrapper">
                                        <i class="bi bi-calendar3"></i>
                                        <input asp-for="CheckInDate" type="date" class="app-form-control" />
                                    </div>
                                    <span asp-validation-for="CheckInDate" class="app-validation-message"></span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="app-form-group">
                                    <label asp-for="EstimatedDeliveryDate" class="app-form-label">
                                        <i class="bi bi-calendar-event-fill"></i>
                                        Tahmini Teslim Tarihi <span>*</span>
                                    </label>
                                    <div class="app-input-wrapper">
                                        <i class="bi bi-calendar3"></i>
                                        <input asp-for="EstimatedDeliveryDate" type="date" class="app-form-control" />
                                    </div>
                                    <span asp-validation-for="EstimatedDeliveryDate" class="app-validation-message"></span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="app-form-group">
                                    <label asp-for="Mileage" class="app-form-label">
                                        <i class="bi bi-speedometer2"></i>
                                        Kilometre <span>*</span>
                                    </label>
                                    <div class="app-input-wrapper">
                                        <i class="bi bi-speedometer"></i>
                                        <input asp-for="Mileage"
                                               type="number"
                                               min="0"
                                               class="app-form-control"
                                               placeholder="Örn: 125000" />
                                    </div>
                                    <span asp-validation-for="Mileage" class="app-validation-message"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="service-form-section">
                        <div class="service-form-section-header">
                            <div class="service-form-section-icon icon-danger">
                                <i class="bi bi-chat-left-text-fill"></i>
                            </div>
                            <div>
                                <h6>Servis Açıklamaları</h6>
                                <span>Müşteri şikâyeti ve servis kabul açıklaması</span>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-12">
                                <div class="app-form-group">
                                    <label asp-for="CustomerComplaint" class="app-form-label">
                                        <i class="bi bi-person-exclamation"></i>
                                        Müşteri Şikâyeti <span>*</span>
                                    </label>
                                    <div class="app-textarea-wrapper">
                                        <i class="bi bi-chat-left-text"></i>
                                        <textarea asp-for="CustomerComplaint"
                                                  rows="4"
                                                  class="app-form-control"
                                                  placeholder="Müşterinin bildirdiği şikâyeti yazın"></textarea>
                                    </div>
                                    <span asp-validation-for="CustomerComplaint" class="app-validation-message"></span>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="app-form-group">
                                    <label asp-for="Description" class="app-form-label">
                                        <i class="bi bi-card-text"></i>
                                        Servis Kabul Açıklaması
                                    </label>
                                    <div class="app-textarea-wrapper">
                                        <i class="bi bi-card-text"></i>
                                        <textarea asp-for="Description"
                                                  rows="4"
                                                  class="app-form-control"
                                                  placeholder="Servis kabulüyle ilgili genel açıklamayı yazın"></textarea>
                                    </div>
                                    <span asp-validation-for="Description" class="app-validation-message"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="service-form-section">
                        <div class="service-form-section-header">
                            <div class="service-form-section-icon icon-success">
                                <i class="bi bi-clipboard2-check-fill"></i>
                            </div>
                            <div>
                                <h6>Servis Kabul Bilgileri</h6>
                                <span>Yakıt, hasar, teslim edilen eşya ve danışman bilgileri</span>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="app-form-group">
                                    <label asp-for="FuelLevel" class="app-form-label">
                                        <i class="bi bi-fuel-pump-fill"></i>
                                        Yakıt Seviyesi
                                    </label>
                                    <div class="app-select-wrapper">
                                        <i class="bi bi-speedometer"></i>
                                        <select asp-for="FuelLevel" class="app-form-control app-form-select">
                                            <option value="0">Boş</option>
                                            <option value="1">1/4</option>
                                            <option value="2">1/2</option>
                                            <option value="3">3/4</option>
                                            <option value="4">Dolu</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="FuelLevel" class="app-validation-message"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="app-form-group">
                                    <label asp-for="AdvisorName" class="app-form-label">
                                        <i class="bi bi-person-badge-fill"></i>
                                        Servis Danışmanı
                                    </label>
                                    <div class="app-input-wrapper">
                                        <i class="bi bi-person"></i>
                                        <input asp-for="AdvisorName"
                                               class="app-form-control"
                                               placeholder="Servis danışmanının adı soyadı" />
                                    </div>
                                    <span asp-validation-for="AdvisorName" class="app-validation-message"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="app-form-group">
                                    <label asp-for="ExistingDamages" class="app-form-label">
                                        <i class="bi bi-exclamation-triangle-fill"></i>
                                        Araç Üzerindeki Hasarlar
                                    </label>
                                    <div class="app-textarea-wrapper">
                                        <i class="bi bi-car-front"></i>
                                        <textarea asp-for="ExistingDamages"
                                                  rows="5"
                                                  class="app-form-control"
                                                  placeholder="Çizik, göçük, kırık veya mevcut hasarları yazın"></textarea>
                                    </div>
                                    <span asp-validation-for="ExistingDamages" class="app-validation-message"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="app-form-group">
                                    <label asp-for="DeliveredItems" class="app-form-label">
                                        <i class="bi bi-box-seam-fill"></i>
                                        Teslim Edilen Eşyalar
                                    </label>
                                    <div class="app-textarea-wrapper">
                                        <i class="bi bi-box-seam"></i>
                                        <textarea asp-for="DeliveredItems"
                                                  rows="5"
                                                  class="app-form-control"
                                                  placeholder="Stepne, kriko, ruhsat, bijon anahtarı vb."></textarea>
                                    </div>
                                    <span asp-validation-for="DeliveredItems" class="app-validation-message"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="app-form-group">
                                    <label asp-for="VehicleDeliveredBy" class="app-form-label">
                                        <i class="bi bi-person-check-fill"></i>
                                        Aracı Teslim Eden
                                    </label>
                                    <div class="app-input-wrapper">
                                        <i class="bi bi-person"></i>
                                        <input asp-for="VehicleDeliveredBy"
                                               class="app-form-control"
                                               placeholder="Aracı servise teslim eden kişinin adı soyadı" />
                                    </div>
                                    <span asp-validation-for="VehicleDeliveredBy" class="app-validation-message"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="app-form-group">
                                    <label asp-for="VehicleDeliveredByPhone" class="app-form-label">
                                        <i class="bi bi-telephone-fill"></i>
                                        Teslim Eden Telefon
                                    </label>
                                    <div class="app-input-wrapper">
                                        <i class="bi bi-telephone"></i>
                                        <input asp-for="VehicleDeliveredByPhone"
                                               class="app-form-control"
                                               placeholder="05xx xxx xx xx" />
                                    </div>
                                    <span asp-validation-for="VehicleDeliveredByPhone" class="app-validation-message"></span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="app-form-group">
                                    <label asp-for="PreApprovalLimit" class="app-form-label">
                                        <i class="bi bi-cash-coin"></i>
                                        Ön Onay Limiti
                                    </label>
                                    <div class="app-input-wrapper">
                                        <i class="bi bi-currency-lira"></i>
                                        <input asp-for="PreApprovalLimit"
                                               type="number"
                                               min="0"
                                               step="0.01"
                                               class="app-form-control"
                                               placeholder="Örn: 5000" />
                                    </div>
                                    <span asp-validation-for="PreApprovalLimit" class="app-validation-message"></span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="app-form-group h-100">
                                    <label class="app-form-label">
                                        <i class="bi bi-shield-check"></i>
                                        Ek İşlem Onayı
                                    </label>

                                    <div class="form-check form-switch app-switch-card">
                                        <input asp-for="RequiresApprovalForExtraWork"
                                               class="form-check-input"
                                               type="checkbox" />
                                        <label asp-for="RequiresApprovalForExtraWork"
                                               class="form-check-label">
                                            Ek işlem öncesi müşteri onayı alınsın
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="app-form-group h-100">
                                    <label class="app-form-label">
                                        <i class="bi bi-recycle"></i>
                                        Eski Parçalar
                                    </label>

                                    <div class="form-check form-switch app-switch-card">
                                        <input asp-for="ReturnOldPartsToCustomer"
                                               class="form-check-input"
                                               type="checkbox" />
                                        <label asp-for="ReturnOldPartsToCustomer"
                                               class="form-check-label">
                                            Eski parçalar müşteriye teslim edilsin
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="app-form-group">
                                    <label asp-for="CustomerNotes" class="app-form-label">
                                        <i class="bi bi-journal-text"></i>
                                        Müşteri Notu
                                    </label>
                                    <div class="app-textarea-wrapper">
                                        <i class="bi bi-journal-text"></i>
                                        <textarea asp-for="CustomerNotes"
                                                  rows="4"
                                                  class="app-form-control"
                                                  placeholder="Müşterinin özel talep ve notlarını yazın"></textarea>
                                    </div>
                                    <span asp-validation-for="CustomerNotes" class="app-validation-message"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="app-form-actions">
                        <a asp-action="Index" class="btn-app-secondary">
                            <i class="bi bi-x-circle"></i>
                            Vazgeç
                        </a>

                        <button type="submit" class="btn-app-primary">
                            <i class="bi bi-check-circle-fill"></i>
                            Servis Kaydını Oluştur
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-3">
        <div class="app-card form-info-card">
            <div class="form-info-icon">
                <i class="bi bi-info-circle-fill"></i>
            </div>

            <h5>Servis Kabulü</h5>

            <p>
                Bu bilgiler servis kabul formunda ve aracın servis geçmişinde kullanılacaktır.
            </p>

            <ul class="form-info-list">
                <li><i class="bi bi-check-circle-fill"></i>Araç bilgilerini kontrol edin</li>
                <li><i class="bi bi-check-circle-fill"></i>Güncel kilometreyi girin</li>
                <li><i class="bi bi-check-circle-fill"></i>Yakıt seviyesini işaretleyin</li>
                <li><i class="bi bi-check-circle-fill"></i>Mevcut hasarları kaydedin</li>
                <li><i class="bi bi-check-circle-fill"></i>Teslim edilen eşyaları yazın</li>
                <li><i class="bi bi-check-circle-fill"></i>Şikâyeti açık ve eksiksiz yazın</li>
            </ul>
        </div>
    </div>
</div>


<style>
    .app-switch-card {
        min-height: 54px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #f8fafc;
    }

        .app-switch-card .form-check-input {
            width: 2.7rem;
            height: 1.35rem;
            margin: 0;
            flex: 0 0 auto;
            cursor: pointer;
        }

        .app-switch-card .form-check-label {
            margin: 0;
            font-size: 13px;
            font-weight: 700;
            color: #344054;
            line-height: 1.4;
            cursor: pointer;
        }
</style>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
