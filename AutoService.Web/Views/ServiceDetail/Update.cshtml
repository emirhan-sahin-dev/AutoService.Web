@model AutoService.Dto.ServiceDetailDtos.UpdateServiceDetailDto

@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Servis Detayı Güncelle";
}

<div class="page-header">

    <div>

        <div class="page-header-label">
            <i class="bi bi-pencil-square"></i>
            Servis Parça Yönetimi
        </div>

        <h1>Servis Detayını Güncelle</h1>

        <p>
            Serviste kullanılan parça ve miktar bilgilerini düzenleyin.
        </p>

    </div>

    <a asp-action="Index"
       class="btn-app-secondary">

        <i class="bi bi-arrow-left"></i>
        Servis Detayları

    </a>

</div>

<div class="row g-4">

    <div class="col-xl-8">

        <div class="app-card">

            <div class="app-card-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="chart-header-icon icon-warning">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>

                    <div class="app-card-title">

                        <h5>Parça Kullanımını Düzenle</h5>

                        <span>
                            Mevcut servis detayındaki bilgileri değiştirin
                        </span>

                    </div>

                </div>

                <span class="app-badge app-badge-warning">

                    <i class="bi bi-hash"></i>
                    @Model.ServiceDetailId

                </span>

            </div>

            <div class="app-card-body">

                <form asp-action="Update"
                      method="post"
                      class="app-form">

                    <input asp-for="ServiceDetailId"
                           type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="service-detail-form-visual">

                        <div class="service-detail-flow-item">

                            <div class="service-detail-flow-icon icon-primary">
                                <i class="bi bi-wrench-adjustable-circle-fill"></i>
                            </div>

                            <span>Servis Kaydı</span>

                        </div>

                        <i class="bi bi-arrow-right service-detail-flow-arrow"></i>

                        <div class="service-detail-flow-item">

                            <div class="service-detail-flow-icon icon-warning">
                                <i class="bi bi-box-seam-fill"></i>
                            </div>

                            <span>Yedek Parça</span>

                        </div>

                        <i class="bi bi-arrow-right service-detail-flow-arrow"></i>

                        <div class="service-detail-flow-item">

                            <div class="service-detail-flow-icon icon-success">
                                <i class="bi bi-calculator-fill"></i>
                            </div>

                            <span>Miktar</span>

                        </div>

                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <div class="app-form-group">

                                <label asp-for="ServiceRecordId"
                                       class="app-form-label">

                                    <i class="bi bi-wrench-adjustable-circle-fill"></i>
                                    Servis Kaydı
                                    <span>*</span>

                                </label>

                                <div class="app-select-wrapper">

                                    <i class="bi bi-car-front"></i>

                                    <select asp-for="ServiceRecordId"
                                            asp-items="@(new SelectList(
                                                                                            ViewBag.ServiceRecords,
                                                                                            "ServiceRecordId",
                                                                                            "Plate",
                                                                                            Model.ServiceRecordId
                                                                                        ))"
                                            class="app-form-control app-form-select">

                                        <option value="">
                                            Servis kaydı seçiniz
                                        </option>

                                    </select>

                                </div>

                                <span asp-validation-for="ServiceRecordId"
                                      class="app-validation-message">
                                </span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="app-form-group">

                                <label asp-for="SparePartId"
                                       class="app-form-label">

                                    <i class="bi bi-box-seam-fill"></i>
                                    Yedek Parça
                                    <span>*</span>

                                </label>

                                <div class="app-select-wrapper">

                                    <i class="bi bi-gear-wide-connected"></i>

                                    <select asp-for="SparePartId"
                                            asp-items="@(new SelectList(
                                                                                            ViewBag.SpareParts,
                                                                                            "SparePartId",
                                                                                            "PartName",
                                                                                            Model.SparePartId
                                                                                        ))"
                                            class="app-form-control app-form-select">

                                        <option value="">
                                            Yedek parça seçiniz
                                        </option>

                                    </select>

                                </div>

                                <span asp-validation-for="SparePartId"
                                      class="app-validation-message">
                                </span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="app-form-group">

                                <label asp-for="Quantity"
                                       class="app-form-label">

                                    <i class="bi bi-123"></i>
                                    Kullanılan Adet
                                    <span>*</span>

                                </label>

                                <div class="app-input-wrapper">

                                    <i class="bi bi-calculator"></i>

                                    <input asp-for="Quantity"
                                           type="number"
                                           min="1"
                                           class="app-form-control" />

                                </div>

                                <span asp-validation-for="Quantity"
                                      class="app-validation-message">
                                </span>

                            </div>

                        </div>

                    </div>

                    <div class="service-detail-form-notice warning">

                        <i class="bi bi-exclamation-triangle-fill"></i>

                        <div>

                            <strong>Güncelleme uyarısı</strong>

                            <span>
                                Parça veya miktar değişikliği servis tutarını
                                ve stok bilgilerini etkileyebilir.
                            </span>

                        </div>

                    </div>

                    <div class="app-form-actions">

                        <a asp-action="Index"
                           class="btn-app-secondary">

                            <i class="bi bi-x-circle"></i>
                            Vazgeç

                        </a>

                        <button type="submit"
                                class="btn-app-warning">

                            <i class="bi bi-check-circle-fill"></i>
                            Değişiklikleri Kaydet

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <div class="col-xl-4">

        <div class="app-card form-info-card form-info-warning">

            <div class="form-info-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <h5>Güncelleme Bilgisi</h5>

            <p>
                Burada yaptığınız değişiklikler mevcut servis kaydının
                parça maliyetini değiştirebilir.
            </p>

            <ul class="form-info-list">

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Servis kaydını kontrol edin
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Parça değişikliğine dikkat edin
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Kullanılan miktarı doğrulayın
                </li>

            </ul>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}