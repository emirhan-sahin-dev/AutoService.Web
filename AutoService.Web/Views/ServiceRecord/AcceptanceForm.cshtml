@model AutoService.Dto.ServiceRecordDtos.ServiceAcceptanceFormDto

@using AutoService.Entity.Enums

@{
    ViewData["Title"] = "Servis Kabul Formu";

    var fuelText = Model.FuelLevel switch
    {
        FuelLevel.Bos => "Boş",
        FuelLevel.Ceyrek => "1/4",
        FuelLevel.Yarım => "1/2",
        FuelLevel.UcCeyrek => "3/4",
        FuelLevel.Dolu => "Dolu",
        _ => "-"
    };

    var approvalText = Model.RequiresApprovalForExtraWork
        ? "Ek işlem öncesi müşteri onayı zorunludur."
        : "Ön onay limiti dahilindeki ek işlemler için ayrıca onay aranmaz.";

    var oldPartsText = Model.ReturnOldPartsToCustomer
        ? "Değiştirilen eski parçalar müşteriye teslim edilecektir."
        : "Değiştirilen eski parçaların müşteriye teslimi talep edilmemiştir.";
}

<style>
    .acceptance-page {
        max-width: 1120px;
        margin: 0 auto;
    }

    .acceptance-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .acceptance-paper {
        background: #fff;
        border: 1px solid #dfe5ec;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 14px 40px rgba(15, 23, 42, .08);
        color: #172033;
    }

    .acceptance-accent {
        height: 7px;
        background: linear-gradient(90deg, #2563eb, #06b6d4, #22c55e);
    }

    .acceptance-inner {
        padding: 34px;
    }

    .acceptance-header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 28px;
        padding-bottom: 22px;
        border-bottom: 2px solid #e8edf3;
    }

    .acceptance-brand {
        display: flex;
        gap: 15px;
        align-items: flex-start;
    }

    .acceptance-brand-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        display: grid;
        place-items: center;
        background: #eff6ff;
        color: #2563eb;
        font-size: 27px;
        flex: 0 0 auto;
    }

    .acceptance-brand h2 {
        margin: 0;
        font-size: 25px;
        font-weight: 900;
    }

    .acceptance-brand-details {
        display: grid;
        gap: 4px;
        margin-top: 8px;
        color: #667085;
        font-size: 13px;
    }

    .acceptance-title {
        text-align: right;
        min-width: 260px;
    }

        .acceptance-title h1 {
            margin: 0;
            font-size: 27px;
            font-weight: 950;
        }

        .acceptance-title span {
            display: block;
            margin-top: 8px;
            color: #667085;
            font-size: 13px;
            font-weight: 700;
        }

    .acceptance-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-top: 22px;
    }

    .acceptance-section {
        border: 1px solid #e2e8f0;
        border-radius: 15px;
        overflow: hidden;
        margin-top: 20px;
    }

        .acceptance-section.no-margin {
            margin-top: 0;
        }

    .acceptance-section-title {
        padding: 12px 16px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        font-size: 13px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .acceptance-section-body {
        padding: 16px;
    }

    .info-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px 18px;
    }

    .info-item span {
        display: block;
        color: #667085;
        font-size: 11px;
        margin-bottom: 4px;
    }

    .info-item strong {
        display: block;
        font-size: 13px;
        line-height: 1.45;
        word-break: break-word;
    }

    .acceptance-text-box {
        min-height: 88px;
        border: 1px dashed #cbd5e1;
        border-radius: 11px;
        padding: 14px;
        white-space: pre-wrap;
        line-height: 1.55;
        font-size: 13px;
    }

    .fuel-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .fuel-option {
        border: 1px solid #cbd5e1;
        border-radius: 999px;
        padding: 8px 14px;
        font-size: 12px;
        font-weight: 800;
    }

        .fuel-option.active {
            background: #e8f1ff;
            border-color: #3b82f6;
            color: #1d4ed8;
        }

    .approval-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .approval-card {
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        padding: 14px;
        background: #fbfdff;
    }

        .approval-card span {
            display: block;
            color: #667085;
            font-size: 11px;
            margin-bottom: 6px;
        }

        .approval-card strong {
            display: block;
            font-size: 13px;
            line-height: 1.45;
        }

        .approval-card .yes {
            color: #15803d;
        }

        .approval-card .no {
            color: #b45309;
        }

    .acceptance-legal {
        margin-top: 22px;
        padding: 16px 18px;
        border: 1px solid #dbeafe;
        border-radius: 14px;
        background: #eff6ff;
        color: #334155;
        font-size: 12px;
        line-height: 1.65;
    }

        .acceptance-legal strong {
            display: block;
            margin-bottom: 6px;
            color: #1e3a8a;
            font-size: 13px;
        }

    .acceptance-signatures {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 28px;
        margin-top: 44px;
    }

    .signature-box {
        text-align: center;
    }

    .signature-space {
        height: 58px;
    }

    .signature-line {
        border-top: 1px solid #94a3b8;
        padding-top: 8px;
        font-size: 12px;
        font-weight: 850;
    }

    .signature-name {
        margin-top: 4px;
        min-height: 18px;
        color: #667085;
        font-size: 11px;
    }

    .acceptance-footer {
        margin-top: 26px;
        padding-top: 15px;
        border-top: 1px solid #e2e8f0;
        color: #667085;
        font-size: 10px;
        line-height: 1.55;
        text-align: center;
    }

    @@media (max-width: 850px) {
        .acceptance-header,
        .acceptance-grid,
        .info-list,
        .approval-grid,
        .acceptance-signatures {
            grid-template-columns: 1fr;
        }

        .acceptance-title {
            text-align: left;
            min-width: 0;
        }

        .acceptance-inner {
            padding: 20px;
        }
    }

    @@media print {
        body {
            background: #fff !important;
        }

        .sidebar,
        .navbar,
        .topbar,
        .acceptance-toolbar,
        footer {
            display: none !important;
        }

        main,
        .main-content,
        .content-wrapper,
        .container-fluid {
            width: 100% !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .acceptance-page {
            max-width: none;
            margin: 0;
        }

        .acceptance-paper {
            border: none;
            box-shadow: none;
            border-radius: 0;
        }

        .acceptance-inner {
            padding: 7mm;
        }

        .acceptance-section,
        .approval-card,
        .acceptance-legal {
            break-inside: avoid;
        }

        @@page {
            size: A4;
            margin: 8mm;
        }
    }
</style>

<div class="acceptance-page">

    <div class="acceptance-toolbar">
        <a asp-action="Detail"
           asp-route-id="@Model.ServiceRecordId"
           class="btn-app-secondary">
            <i class="bi bi-arrow-left"></i>
            Servis Kaydına Dön
        </a>

        <button type="button"
                onclick="window.print()"
                class="btn-app-primary">
            <i class="bi bi-printer-fill"></i>
            Yazdır / PDF
        </button>
    </div>

    <div class="acceptance-paper">
        <div class="acceptance-accent"></div>

        <div class="acceptance-inner">

            <div class="acceptance-header">
                <div class="acceptance-brand">
                    <div class="acceptance-brand-icon">
                        <i class="bi bi-wrench-adjustable-circle-fill"></i>
                    </div>

                    <div>
                        <h2>@Model.CompanyName</h2>

                        <div class="acceptance-brand-details">
                            <span>@(Model.CompanyPhone ?? "-")</span>
                            <span>@(Model.CompanyEmail ?? "-")</span>
                            <span>@(Model.CompanyAddress ?? "-")</span>
                        </div>
                    </div>
                </div>

                <div class="acceptance-title">
                    <h1>SERVİS KABUL FORMU</h1>
                    <span>Servis No: #@Model.ServiceRecordId</span>
                    <span>Tarih: @Model.CheckInDate.ToString("dd.MM.yyyy HH:mm")</span>
                </div>
            </div>

            <div class="acceptance-grid">
                <div class="acceptance-section no-margin">
                    <div class="acceptance-section-title">Müşteri Bilgileri</div>
                    <div class="acceptance-section-body">
                        <div class="info-list">
                            <div class="info-item">
                                <span>Ad Soyad</span>
                                <strong>@Model.CustomerName</strong>
                            </div>
                            <div class="info-item">
                                <span>Telefon</span>
                                <strong>@Model.CustomerPhone</strong>
                            </div>
                            <div class="info-item">
                                <span>E-Posta</span>
                                <strong>@Model.CustomerEmail</strong>
                            </div>
                            <div class="info-item">
                                <span>Adres</span>
                                <strong>@Model.CustomerAddress</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="acceptance-section no-margin">
                    <div class="acceptance-section-title">Araç Bilgileri</div>
                    <div class="acceptance-section-body">
                        <div class="info-list">
                            <div class="info-item">
                                <span>Plaka</span>
                                <strong>@Model.Plate</strong>
                            </div>
                            <div class="info-item">
                                <span>Marka / Model</span>
                                <strong>@Model.BrandName @Model.ModelName</strong>
                            </div>
                            <div class="info-item">
                                <span>Model Yılı</span>
                                <strong>@Model.ModelYear</strong>
                            </div>
                            <div class="info-item">
                                <span>Kilometre</span>
                                <strong>@Model.Mileage.ToString("N0") KM</strong>
                            </div>
                            <div class="info-item">
                                <span>Şasi No</span>
                                <strong>@Model.VinNumber</strong>
                            </div>
                            <div class="info-item">
                                <span>Tahmini Teslim</span>
                                <strong>
                                    @(Model.EstimatedDeliveryDate.HasValue
                                                                        ? Model.EstimatedDeliveryDate.Value.ToString("dd.MM.yyyy HH:mm")
                                                                        : "-")
                                </strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="acceptance-section">
                <div class="acceptance-section-title">Aracı Teslim Eden Kişi</div>
                <div class="acceptance-section-body">
                    <div class="info-list">
                        <div class="info-item">
                            <span>Ad Soyad</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.VehicleDeliveredBy)
                                                                ? Model.CustomerName
                                                                : Model.VehicleDeliveredBy)
                            </strong>
                        </div>

                        <div class="info-item">
                            <span>Telefon</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.VehicleDeliveredByPhone)
                                                                ? Model.CustomerPhone
                                                                : Model.VehicleDeliveredByPhone)
                            </strong>
                        </div>

                        <div class="info-item">
                            <span>Servis Danışmanı</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.AdvisorName)
                                                                ? "-"
                                                                : Model.AdvisorName)
                            </strong>
                        </div>

                        <div class="info-item">
                            <span>Yakıt Seviyesi</span>
                            <strong>@fuelText</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="acceptance-section">
                <div class="acceptance-section-title">Yakıt Seviyesi</div>
                <div class="acceptance-section-body">
                    <div class="fuel-row">
                        @foreach (var value in new[] { "Boş", "1/4", "1/2", "3/4", "Dolu" })
                        {
                            <span class="fuel-option @(fuelText == value ? "active" : "")">
                                @(fuelText == value ? "✓ " : "")
                                @value
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="acceptance-section">
                <div class="acceptance-section-title">Müşteri Şikâyeti</div>
                <div class="acceptance-section-body">
                    <div class="acceptance-text-box">
                        @Model.CustomerComplaint
                    </div>
                </div>
            </div>

            <div class="acceptance-grid">
                <div class="acceptance-section no-margin">
                    <div class="acceptance-section-title">Araç Üzerindeki Mevcut Hasarlar</div>
                    <div class="acceptance-section-body">
                        <div class="acceptance-text-box">
                            @(string.IsNullOrWhiteSpace(Model.ExistingDamages)
                                                        ? "Mevcut hasar bilgisi girilmemiştir."
                                                        : Model.ExistingDamages)
                        </div>
                    </div>
                </div>

                <div class="acceptance-section no-margin">
                    <div class="acceptance-section-title">Araçla Birlikte Teslim Edilen Eşyalar</div>
                    <div class="acceptance-section-body">
                        <div class="acceptance-text-box">
                            @(string.IsNullOrWhiteSpace(Model.DeliveredItems)
                                                        ? "Teslim edilen eşya bilgisi girilmemiştir."
                                                        : Model.DeliveredItems)
                        </div>
                    </div>
                </div>
            </div>

            <div class="acceptance-grid">
                <div class="acceptance-section no-margin">
                    <div class="acceptance-section-title">Servis Kabul Açıklaması</div>
                    <div class="acceptance-section-body">
                        <div class="acceptance-text-box">
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                                        ? "Açıklama bulunmuyor."
                                                        : Model.Description)
                        </div>
                    </div>
                </div>

                <div class="acceptance-section no-margin">
                    <div class="acceptance-section-title">Müşteri Özel Notu</div>
                    <div class="acceptance-section-body">
                        <div class="acceptance-text-box">
                            @(string.IsNullOrWhiteSpace(Model.CustomerNotes)
                                                        ? "Müşteri notu bulunmuyor."
                                                        : Model.CustomerNotes)
                        </div>
                    </div>
                </div>
            </div>

            <div class="acceptance-section">
                <div class="acceptance-section-title">Ön Onay ve Parça Teslim Tercihleri</div>
                <div class="acceptance-section-body">
                    <div class="approval-grid">
                        <div class="approval-card">
                            <span>Ön Onay Limiti</span>
                            <strong>@Model.PreApprovalLimit.ToString("N2") ₺</strong>
                        </div>

                        <div class="approval-card">
                            <span>Ek İşlem Onayı</span>
                            <strong class="@(Model.RequiresApprovalForExtraWork ? "yes" : "no")">
                                @(Model.RequiresApprovalForExtraWork ? "Onay Zorunlu" : "Limit Dahilinde Serbest")
                            </strong>
                        </div>

                        <div class="approval-card">
                            <span>Eski Parçalar</span>
                            <strong class="@(Model.ReturnOldPartsToCustomer ? "yes" : "no")">
                                @(Model.ReturnOldPartsToCustomer ? "Müşteriye Verilecek" : "Teslim Talebi Yok")
                            </strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="acceptance-legal">
                <strong>Müşteri Onayı ve Servis Koşulları</strong>

                Araç, yukarıda belirtilen kilometre, yakıt seviyesi, mevcut hasarlar ve araçla birlikte
                teslim edilen eşyalarla servise kabul edilmiştir. Müşteri tarafından bildirilen şikâyetlerin
                kontrol edilmesine ve gerekli arıza tespit işlemlerinin yapılmasına izin verilmiştir.
                @approvalText Ön onay limiti @Model.PreApprovalLimit.ToString("N2") ₺ olarak belirlenmiştir.
                @oldPartsText Tahmini teslim tarihi, ek arıza tespitleri ve parça temin süresine bağlı olarak
                değişebilir. Servis, ek işlem veya maliyet değişikliklerinde kayıtlı iletişim bilgileri üzerinden
                müşteriyle iletişime geçer.
            </div>

            <div class="acceptance-signatures">
                <div class="signature-box">
                    <div class="signature-space"></div>
                    <div class="signature-line">Servis Danışmanı</div>
                    <div class="signature-name">
                        @(string.IsNullOrWhiteSpace(Model.AdvisorName)
                                                ? "Ad Soyad / İmza"
                                                : Model.AdvisorName)
                    </div>
                </div>

                <div class="signature-box">
                    <div class="signature-space"></div>
                    <div class="signature-line">Aracı Teslim Eden</div>
                    <div class="signature-name">
                        @(string.IsNullOrWhiteSpace(Model.VehicleDeliveredBy)
                                                ? Model.CustomerName
                                                : Model.VehicleDeliveredBy)
                    </div>
                </div>

                <div class="signature-box">
                    <div class="signature-space"></div>
                    <div class="signature-line">Müşteri Onayı</div>
                    <div class="signature-name">Ad Soyad / İmza</div>
                </div>
            </div>

            <div class="acceptance-footer">
                Bu form aracın servise kabul edildiği andaki durumunu ve müşteri taleplerini kayıt altına alır.
                Yapılan işlemler, kullanılan parçalar ve nihai ücretler servis çıkış fişinde gösterilir.
            </div>

        </div>
    </div>
</div>
