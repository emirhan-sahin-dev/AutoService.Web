@using AutoService.Web.Security
@model List<AutoService.Dto.ServiceDetailDtos.ResultServiceDetailDto>

@{
    ViewData["Title"] = "Servis Detayları";

    var keyword = ViewBag.Keyword as string;

    var currentPage = ViewBag.CurrentPage != null
        ? Convert.ToInt32(ViewBag.CurrentPage)
        : 1;

    var totalPage = ViewBag.TotalPage != null
        ? Convert.ToInt32(ViewBag.TotalPage)
        : 1;

    var totalCount = ViewBag.TotalCount != null
        ? Convert.ToInt32(ViewBag.TotalCount)
        : Model.Count;

    var totalQuantity = Model.Sum(x => x.Quantity);

    var pageTotalPrice = Model.Sum(x => x.TotalPrice);

    var sparePartCount = Model
        .Where(x => !string.IsNullOrWhiteSpace(x.SparePartName))
        .Select(x => x.SparePartName)
        .Distinct()
        .Count();

    var canManageServices =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.ServiceAdvisor);
}

<div class="page-header">

    <div>

        <div class="page-header-label">

            <i class="bi bi-list-check"></i>

            Servis İşlem Yönetimi

        </div>

        <h1>Servis Detayları</h1>

        <p>
            Servis kayıtlarında kullanılan yedek parçaları,
            miktarları ve fiyatları yönetin.
        </p>

    </div>

    @if (canManageServices)
    {
        <a asp-action="Create"
           class="btn-app-primary">

            <i class="bi bi-plus-circle-fill"></i>

            Yeni Servis Detayı

        </a>
    }

</div>

<!-- ÖZET KARTLARI -->
<div class="row g-4 mb-4">

    <div class="col-xl-3 col-md-6">

        <div class="dashboard-alert dashboard-alert-primary">

            <div class="dashboard-alert-icon icon-primary">

                <i class="bi bi-list-check"></i>

            </div>

            <div class="dashboard-alert-content">

                <strong>@totalCount</strong>

                <span>
                    Arama sonucundaki işlem
                </span>

            </div>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="dashboard-alert dashboard-alert-success">

            <div class="dashboard-alert-icon icon-success">

                <i class="bi bi-box-seam-fill"></i>

            </div>

            <div class="dashboard-alert-content">

                <strong>@totalQuantity</strong>

                <span>
                    Bu sayfadaki toplam parça
                </span>

            </div>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="dashboard-alert dashboard-alert-warning">

            <div class="dashboard-alert-icon icon-warning">

                <i class="bi bi-tools"></i>

            </div>

            <div class="dashboard-alert-content">

                <strong>@sparePartCount</strong>

                <span>
                    Farklı yedek parça
                </span>

            </div>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="dashboard-alert dashboard-alert-danger">

            <div class="dashboard-alert-icon icon-danger">

                <i class="bi bi-cash-stack"></i>

            </div>

            <div class="dashboard-alert-content">

                <strong>
                    @pageTotalPrice.ToString("N2") ₺
                </strong>

                <span>
                    Bu sayfadaki toplam tutar
                </span>

            </div>

        </div>

    </div>

</div>

<div class="app-card">

    <div class="app-card-header">

        <div class="d-flex align-items-center gap-3">

            <div class="chart-header-icon icon-primary">

                <i class="bi bi-wrench-adjustable-circle-fill"></i>

            </div>

            <div class="app-card-title">

                <h5>Servis İşlem Listesi</h5>

                <span>
                    Plaka veya yedek parça adına göre arama yapın
                </span>

            </div>

        </div>

        <span class="app-badge app-badge-primary">

            <i class="bi bi-database"></i>

            @totalCount kayıt

        </span>

    </div>

    <!-- ARAMA -->
    <div class="app-card-body">

        <form method="get"
              asp-action="Index"
              class="customer-filter-form">

            <div class="customer-search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       name="keyword"
                       value="@keyword"
                       placeholder="Plaka veya yedek parça adı ile ara..."
                       autocomplete="off" />

            </div>

            <button type="submit"
                    class="btn-app-primary">

                <i class="bi bi-search"></i>

                Ara

            </button>

            @if (!string.IsNullOrWhiteSpace(keyword))
            {
                <a asp-action="Index"
                   class="btn-app-secondary">

                    <i class="bi bi-x-circle"></i>

                    Temizle

                </a>
            }

        </form>

    </div>

    <!-- TABLO -->
    <div class="app-card-body p-0">

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table app-table align-middle mb-0">

                    <thead>

                        <tr>

                            <th>Servis Kaydı</th>

                            <th>Yedek Parça</th>

                            <th>Adet</th>

                            <th>Birim Fiyat</th>

                            <th>Toplam Tutar</th>

                            <th class="text-end">
                                İşlemler
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <div class="service-detail-vehicle">

                                        <div class="service-detail-vehicle-icon">

                                            <i class="bi bi-car-front-fill"></i>

                                        </div>

                                        <div>

                                            @if (!string.IsNullOrWhiteSpace(item.Plate))
                                            {
                                                <span class="plate-badge">
                                                    @item.Plate
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="customer-empty-value">

                                                    <i class="bi bi-dash-circle"></i>

                                                    Plaka yok

                                                </span>
                                            }

                                            <span class="service-detail-subtitle">
                                                Servis kaydı
                                            </span>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    <div class="service-detail-part">

                                        <div class="service-detail-part-icon">

                                            <i class="bi bi-gear-wide-connected"></i>

                                        </div>

                                        <div>

                                            <strong>
                                                @item.SparePartName
                                            </strong>

                                            <span>
                                                Kullanılan yedek parça
                                            </span>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    <span class="service-detail-quantity">

                                        <i class="bi bi-box-seam"></i>

                                        @item.Quantity adet

                                    </span>

                                </td>

                                <td>

                                    <span class="service-detail-unit-price">
                                        @item.UnitPrice.ToString("N2") ₺
                                    </span>

                                </td>

                                <td>

                                    <span class="service-detail-total-price">
                                        @item.TotalPrice.ToString("N2") ₺
                                    </span>

                                </td>

                                <td>

                                    <div class="table-actions justify-content-end">

                                        <a asp-action="Detail"
                                           asp-route-id="@item.ServiceDetailId"
                                           class="table-action-btn action-detail"
                                           title="Detay">

                                            <i class="bi bi-eye-fill"></i>

                                        </a>

                                        @if (canManageServices)
                                        {
                                            <a asp-action="Update"
                                               asp-route-id="@item.ServiceDetailId"
                                               class="table-action-btn action-edit"
                                               title="Düzenle">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                            <button type="button"
                                                    class="table-action-btn action-delete deleteBtn"
                                                    title="Sil"
                                                    data-id="@item.ServiceDetailId"
                                                    data-plate="@item.Plate"
                                                    data-part="@item.SparePartName">

                                                <i class="bi bi-trash3-fill"></i>

                                            </button>
                                        }

                                    </div>

                                    @if (canManageServices)
                                    {
                                        <form id="delete-@item.ServiceDetailId"
                                              asp-action="Delete"
                                              asp-route-id="@item.ServiceDetailId"
                                              method="post"
                                              class="d-none">

                                            @Html.AntiForgeryToken()

                                        </form>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="dashboard-empty-state customer-empty-state">

                <i class="bi bi-list-check"></i>

                <h6>Servis detayı bulunamadı</h6>

                @if (!string.IsNullOrWhiteSpace(keyword))
                {
                    <span>
                        “@keyword” aramasına uygun servis detayı bulunamadı.
                    </span>

                    <a asp-action="Index"
                       class="btn-app-secondary mt-3">

                        <i class="bi bi-arrow-counterclockwise"></i>

                        Tüm servis detaylarını göster

                    </a>
                }
                else
                {
                    <span>
                        Sistemde henüz servis detayı bulunmuyor.
                    </span>

                    @if (canManageServices)
                    {
                        <a asp-action="Create"
                           class="btn-app-primary mt-3">

                            <i class="bi bi-plus-circle-fill"></i>

                            İlk servis detayını ekle

                        </a>
                    }
                }

            </div>
        }

    </div>

    <!-- SAYFALAMA -->
    @if (totalPage > 1)
    {
        <div class="app-card-footer customer-pagination-footer">

            <div class="pagination-info">

                <i class="bi bi-file-earmark-text"></i>

                <span>
                    Sayfa @currentPage / @totalPage
                </span>

            </div>

            <nav aria-label="Servis detayı sayfaları">

                <ul class="pagination app-pagination mb-0">

                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="1"
                           asp-route-keyword="@keyword"
                           title="İlk sayfa">

                            <i class="bi bi-chevron-double-left"></i>

                        </a>

                    </li>

                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-keyword="@keyword"
                           title="Önceki sayfa">

                            <i class="bi bi-chevron-left"></i>

                        </a>

                    </li>

                    @{
                        var startPage = Math.Max(1, currentPage - 2);
                        var endPage = Math.Min(totalPage, currentPage + 2);
                    }

                    @if (startPage > 1)
                    {
                        <li class="page-item">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="1"
                               asp-route-keyword="@keyword">
                                1
                            </a>

                        </li>

                        @if (startPage > 2)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">…</span>
                            </li>
                        }
                    }

                    @for (var i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-keyword="@keyword">
                                @i
                            </a>

                        </li>
                    }

                    @if (endPage < totalPage)
                    {
                        @if (endPage < totalPage - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">…</span>
                            </li>
                        }

                        <li class="page-item">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@totalPage"
                               asp-route-keyword="@keyword">
                                @totalPage
                            </a>

                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPage ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-keyword="@keyword"
                           title="Sonraki sayfa">

                            <i class="bi bi-chevron-right"></i>

                        </a>

                    </li>

                    <li class="page-item @(currentPage >= totalPage ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@totalPage"
                           asp-route-keyword="@keyword"
                           title="Son sayfa">

                            <i class="bi bi-chevron-double-right"></i>

                        </a>

                    </li>

                </ul>

            </nav>

        </div>
    }

</div>

@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const deleteButtons =
                document.querySelectorAll(".deleteBtn");

            deleteButtons.forEach(function (button) {

                button.addEventListener("click", function () {

                    const id = this.dataset.id;
                    const plate = this.dataset.plate;
                    const part = this.dataset.part;

                    Swal.fire({

                        title: "Servis detayı silinsin mi?",

                        html:
                            "<strong>" +
                            escapeHtml(plate) +
                            "</strong> plakalı araçta kullanılan " +
                            "<strong>" +
                            escapeHtml(part) +
                            "</strong> parçası servis detayından silinecek." +
                            "<br><small>Bu işlem geri alınamaz.</small>",

                        icon: "warning",

                        showCancelButton: true,

                        reverseButtons: true,

                        focusCancel: true,

                        confirmButtonColor: "#dc2626",

                        cancelButtonColor: "#64748b",

                        confirmButtonText:
                            '<i class="bi bi-trash3-fill me-1"></i> Evet, sil',

                        cancelButtonText:
                            '<i class="bi bi-x-circle me-1"></i> İptal'

                    }).then(function (result) {

                        if (result.isConfirmed) {

                            const form =
                                document.getElementById(
                                    "delete-" + id
                                );

                            if (form) {
                                form.submit();
                            }

                        }

                    });

                });

            });

        });

        function escapeHtml(value) {

            const element =
                document.createElement("div");

            element.textContent = value || "";

            return element.innerHTML;

        }

    </script>
}