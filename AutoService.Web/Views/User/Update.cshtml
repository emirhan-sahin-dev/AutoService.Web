@model AutoService.Dto.UserDtos.UpdateUserDto

@{
    ViewData["Title"] = "Kullanıcı Güncelle";
}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-10">

            <div class="card shadow border-0 rounded-4">

                <div class="card-header bg-warning">

                    <h4 class="mb-0 text-dark">
                        <i class="bi bi-person-gear"></i>
                        Kullanıcı Güncelle
                    </h4>

                </div>

                <div class="card-body p-4">

                    <form asp-action="Update"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="UserId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="FullName"
                                       class="form-label fw-semibold">

                                    Ad Soyad

                                </label>

                                <input asp-for="FullName"
                                       class="form-control"
                                       placeholder="Ad ve soyad giriniz" />

                                <span asp-validation-for="FullName"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Username"
                                       class="form-label fw-semibold">

                                    Kullanıcı Adı

                                </label>

                                <input asp-for="Username"
                                       class="form-control"
                                       placeholder="Kullanıcı adı giriniz"
                                       autocomplete="off" />

                                <span asp-validation-for="Username"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Email"
                                       class="form-label fw-semibold">

                                    E-Posta

                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="ornek@mail.com" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="RoleId"
                                       class="form-label fw-semibold">

                                    Kullanıcı Rolü

                                </label>

                                <select asp-for="RoleId"
                                        asp-items="ViewBag.Roles"
                                        class="form-select">

                                    <option value="">
                                        Rol seçiniz
                                    </option>

                                </select>

                                <span asp-validation-for="RoleId"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-12">

                                <div class="border rounded-3 p-3 bg-light">

                                    <div class="d-flex align-items-center justify-content-between">

                                        <div>

                                            <h6 class="mb-1">
                                                Hesap Durumu
                                            </h6>

                                            <small class="text-muted">
                                                Kullanıcının sisteme giriş yapıp yapamayacağını belirler.
                                            </small>

                                        </div>

                                        <div class="form-check form-switch">

                                            <input asp-for="IsActive"
                                                   class="form-check-input"
                                                   type="checkbox"
                                                   role="switch"
                                                   id="isActiveSwitch" />

                                            <label asp-for="IsActive"
                                                   class="form-check-label"
                                                   id="statusLabel">

                                                @(Model.IsActive ? "Aktif" : "Pasif")

                                            </label>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between align-items-center">

                            <a asp-action="Index"
                               class="btn btn-secondary">

                                <i class="bi bi-arrow-left"></i>
                                Listeye Dön

                            </a>

                            <button type="submit"
                                    class="btn btn-warning">

                                <i class="bi bi-check-circle-fill"></i>
                                Değişiklikleri Kaydet

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const statusSwitch =
                document.getElementById("isActiveSwitch");

            const statusLabel =
                document.getElementById("statusLabel");

            if (!statusSwitch || !statusLabel) {
                return;
            }

            function updateStatusLabel() {

                statusLabel.textContent =
                    statusSwitch.checked
                        ? "Aktif"
                        : "Pasif";
            }

            statusSwitch.addEventListener(
                "change",
                updateStatusLabel
            );

            updateStatusLabel();

        });
    </script>
}