@model AutoService.Dto.SystemSettingDtos.UpdateSystemSettingDto

@{
    ViewData["Title"] = "Sistem Ayarları";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-gear-fill me-2"></i>
                Sistem Ayarları
            </h2>

            <p class="text-muted mb-0">
                Firma, servis, stok ve oturum ayarlarını yönetin.
            </p>
        </div>

        <a href="javascript:history.back()"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Dashboard'a Dön

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <form asp-controller="SystemSetting"
          asp-action="Index"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="SystemSettingId" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>

        <div class="row g-4">

            <!-- Firma Bilgileri -->

            <div class="col-xl-8">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-header bg-white border-0 pt-4 px-4">

                        <div class="d-flex align-items-center">

                            <div class="bg-primary bg-opacity-10
                                        text-primary rounded-3 p-3 me-3">

                                <i class="bi bi-building fs-4"></i>

                            </div>

                            <div>
                                <h5 class="fw-bold mb-1">
                                    Firma Bilgileri
                                </h5>

                                <small class="text-muted">
                                    Servis işletmesine ait iletişim bilgileri
                                </small>
                            </div>

                        </div>

                    </div>

                    <div class="card-body p-4">

                        <div class="row g-3">

                            <div class="col-md-12">

                                <label asp-for="CompanyName"
                                       class="form-label fw-semibold">

                                    Firma Adı

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-building"></i>
                                    </span>

                                    <input asp-for="CompanyName"
                                           class="form-control"
                                           placeholder="Firma adını giriniz" />

                                </div>

                                <span asp-validation-for="CompanyName"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="CompanyPhone"
                                       class="form-label fw-semibold">

                                    Telefon

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-telephone"></i>
                                    </span>

                                    <input asp-for="CompanyPhone"
                                           class="form-control"
                                           placeholder="0212 000 00 00" />

                                </div>

                                <span asp-validation-for="CompanyPhone"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="CompanyEmail"
                                       class="form-label fw-semibold">

                                    E-posta

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-envelope"></i>
                                    </span>

                                    <input asp-for="CompanyEmail"
                                           type="email"
                                           class="form-control"
                                           placeholder="info@autoservice.com" />

                                </div>

                                <span asp-validation-for="CompanyEmail"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-12">

                                <label asp-for="CompanyAddress"
                                       class="form-label fw-semibold">

                                    Adres

                                </label>

                                <textarea asp-for="CompanyAddress"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Firma adresini giriniz">
                                </textarea>

                                <span asp-validation-for="CompanyAddress"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Hızlı Bilgi Kartı -->

            <div class="col-xl-4">

                <div class="card border-0 shadow-sm rounded-4 mb-4">

                    <div class="card-body p-4">

                        <div class="d-flex align-items-center mb-3">

                            <div class="bg-info bg-opacity-10
                                        text-info rounded-3 p-3 me-3">

                                <i class="bi bi-info-circle fs-4"></i>

                            </div>

                            <div>
                                <h5 class="fw-bold mb-0">
                                    Ayar Bilgisi
                                </h5>
                            </div>

                        </div>

                        <p class="text-muted small mb-3">
                            Bu sayfadaki ayarlar sistem genelinde kullanılacak
                            varsayılan değerleri belirler.
                        </p>

                        <div class="d-flex align-items-center mb-3">

                            <i class="bi bi-check-circle-fill
                                      text-success me-2">
                            </i>

                            <span class="small">
                                Firma bilgileri
                            </span>

                        </div>

                        <div class="d-flex align-items-center mb-3">

                            <i class="bi bi-check-circle-fill
                                      text-success me-2">
                            </i>

                            <span class="small">
                                Vergi ve para birimi
                            </span>

                        </div>

                        <div class="d-flex align-items-center mb-3">

                            <i class="bi bi-check-circle-fill
                                      text-success me-2">
                            </i>

                            <span class="small">
                                Kritik stok seviyesi
                            </span>

                        </div>

                        <div class="d-flex align-items-center">

                            <i class="bi bi-check-circle-fill
                                      text-success me-2">
                            </i>

                            <span class="small">
                                Oturum süresi
                            </span>

                        </div>

                    </div>

                </div>

                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body p-4">

                        <h6 class="fw-bold">
                            <i class="bi bi-shield-lock me-2"></i>
                            Yetkilendirme
                        </h6>

                        <p class="text-muted small mb-0">
                            Sistem ayarları yalnızca yönetici rolüne sahip
                            kullanıcılar tarafından değiştirilebilir.
                        </p>

                    </div>

                </div>

            </div>

            <!-- Finans Ayarları -->

            <div class="col-lg-6">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-header bg-white border-0 pt-4 px-4">

                        <div class="d-flex align-items-center">

                            <div class="bg-success bg-opacity-10
                                        text-success rounded-3 p-3 me-3">

                                <i class="bi bi-cash-coin fs-4"></i>

                            </div>

                            <div>
                                <h5 class="fw-bold mb-1">
                                    Finans Ayarları
                                </h5>

                                <small class="text-muted">
                                    KDV ve para birimi tercihleri
                                </small>
                            </div>

                        </div>

                    </div>

                    <div class="card-body p-4">

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="VatRate"
                                       class="form-label fw-semibold">

                                    Varsayılan KDV Oranı

                                </label>

                                <div class="input-group">

                                    <input asp-for="VatRate"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           max="100"
                                           class="form-control" />

                                    <span class="input-group-text">
                                        %
                                    </span>

                                </div>

                                <span asp-validation-for="VatRate"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Currency"
                                       class="form-label fw-semibold">

                                    Para Birimi

                                </label>

                                <select asp-for="Currency"
                                        class="form-select">

                                    <option value="TRY">
                                        TRY - Türk Lirası
                                    </option>

                                    <option value="USD">
                                        USD - Amerikan Doları
                                    </option>

                                    <option value="EUR">
                                        EUR - Euro
                                    </option>

                                    <option value="GBP">
                                        GBP - İngiliz Sterlini
                                    </option>

                                </select>

                                <span asp-validation-for="Currency"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Sistem ve Stok Ayarları -->

            <div class="col-lg-6">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-header bg-white border-0 pt-4 px-4">

                        <div class="d-flex align-items-center">

                            <div class="bg-warning bg-opacity-10
                                        text-warning rounded-3 p-3 me-3">

                                <i class="bi bi-sliders fs-4"></i>

                            </div>

                            <div>
                                <h5 class="fw-bold mb-1">
                                    Sistem ve Stok Ayarları
                                </h5>

                                <small class="text-muted">
                                    Bildirim ve güvenlik varsayılanları
                                </small>
                            </div>

                        </div>

                    </div>

                    <div class="card-body p-4">

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="CriticalStockLevel"
                                       class="form-label fw-semibold">

                                    Kritik Stok Seviyesi

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-box-seam"></i>
                                    </span>

                                    <input asp-for="CriticalStockLevel"
                                           type="number"
                                           min="0"
                                           class="form-control" />

                                    <span class="input-group-text">
                                        Adet
                                    </span>

                                </div>

                                <span asp-validation-for="CriticalStockLevel"
                                      class="text-danger small">
                                </span>

                                <small class="text-muted">
                                    Bu miktarın altına düşen parçalar kritik
                                    stok olarak kabul edilir.
                                </small>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="SessionTimeoutMinutes"
                                       class="form-label fw-semibold">

                                    Oturum Süresi

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-clock"></i>
                                    </span>

                                    <input asp-for="SessionTimeoutMinutes"
                                           type="number"
                                           min="1"
                                           class="form-control" />

                                    <span class="input-group-text">
                                        Dakika
                                    </span>

                                </div>

                                <span asp-validation-for="SessionTimeoutMinutes"
                                      class="text-danger small">
                                </span>

                                <small class="text-muted">
                                    Kullanıcı oturumunun varsayılan açık kalma
                                    süresidir.
                                </small>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 mb-4">

            <a href="javascript:history.back()"
               class="btn btn-light border px-4">

                <i class="bi bi-x-circle me-1"></i>
                Vazgeç

            </a>

            <button type="submit"
                    class="btn btn-primary px-4">

                <i class="bi bi-floppy me-1"></i>
                Ayarları Kaydet

            </button>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}