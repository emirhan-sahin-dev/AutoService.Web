@model AutoService.Dto.ServiceDetailDtos.ServiceDetailDetailDto

@{
    ViewData["Title"] = "Servis Detayı";
}

<div class="page-header">

    <div>

        <div class="page-header-label">
            <i class="bi bi-eye-fill"></i>
            Servis Parça Yönetimi
        </div>

        <h1>Servis Detayı</h1>

        <p>
            Servis kaydında kullanılan yedek parça ve miktar bilgilerini
            görüntüleyebilirsiniz.
        </p>

    </div>

    <a asp-action="Index"
       class="btn-app-secondary">

        <i class="bi bi-arrow-left"></i>
        Servis Detayları

    </a>

</div>

<div class="row g-4">

    <div class="col-xl-8">

        <div class="app-card">

            <div class="app-card-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="chart-header-icon icon-primary">
                        <i class="bi bi-clipboard-data-fill"></i>
                    </div>

                    <div class="app-card-title">

                        <h5>Parça Kullanım Bilgileri</h5>

                        <span>
                            Servis detayına ait kayıt bilgileri
                        </span>

                    </div>

                </div>

                <span class="app-badge app-badge-primary">

                    <i class="bi bi-hash"></i>
                    @Model.ServiceDetailId

                </span>

            </div>

            <div class="app-card-body">

                <div class="service-detail-form-visual">

                    <div class="service-detail-flow-item">

                        <div class="service-detail-flow-icon icon-primary">
                            <i class="bi bi-wrench-adjustable-circle-fill"></i>
                        </div>

                        <span>Servis Kaydı</span>

                    </div>

                    <i class="bi bi-arrow-right service-detail-flow-arrow"></i>

                    <div class="service-detail-flow-item">

                        <div class="service-detail-flow-icon icon-warning">
                            <i class="bi bi-box-seam-fill"></i>
                        </div>

                        <span>Yedek Parça</span>

                    </div>

                    <i class="bi bi-arrow-right service-detail-flow-arrow"></i>

                    <div class="service-detail-flow-item">

                        <div class="service-detail-flow-icon icon-success">
                            <i class="bi bi-calculator-fill"></i>
                        </div>

                        <span>Miktar</span>

                    </div>

                </div>

                <div class="row g-4 mt-1">

                    <div class="col-md-6">

                        <div class="app-form-group">

                            <label class="app-form-label">
                                <i class="bi bi-wrench-adjustable-circle-fill"></i>
                                Servis Kayıt Numarası
                            </label>

                            <div class="app-input-wrapper">

                                <i class="bi bi-hash"></i>

                                <input value="@Model.ServiceRecordId"
                                       class="app-form-control"
                                       readonly />

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="app-form-group">

                            <label class="app-form-label">
                                <i class="bi bi-box-seam-fill"></i>
                                Yedek Parça Numarası
                            </label>

                            <div class="app-input-wrapper">

                                <i class="bi bi-hash"></i>

                                <input value="@Model.SparePartId"
                                       class="app-form-control"
                                       readonly />

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="app-form-group">

                            <label class="app-form-label">
                                <i class="bi bi-123"></i>
                                Kullanılan Adet
                            </label>

                            <div class="app-input-wrapper">

                                <i class="bi bi-calculator"></i>

                                <input value="@Model.Quantity"
                                       class="app-form-control"
                                       readonly />

                            </div>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="app-form-group">

                            <label class="app-form-label">
                                <i class="bi bi-fingerprint"></i>
                                Servis Detay Numarası
                            </label>

                            <div class="app-input-wrapper">

                                <i class="bi bi-hash"></i>

                                <input value="@Model.ServiceDetailId"
                                       class="app-form-control"
                                       readonly />

                            </div>

                        </div>

                    </div>

                </div>

                <div class="service-detail-form-notice">

                    <i class="bi bi-info-circle-fill"></i>

                    <div>

                        <strong>Servis detay bilgisi</strong>

                        <span>
                            Bu sayfa yalnızca görüntüleme amaçlıdır.
                            Bilgileri değiştirmek için güncelleme sayfasını kullanabilirsiniz.
                        </span>

                    </div>

                </div>

                <div class="app-form-actions">

                    <a asp-action="Index"
                       class="btn-app-secondary">

                        <i class="bi bi-arrow-left-circle"></i>
                        Listeye Dön

                    </a>

                    <a asp-action="Update"
                       asp-route-id="@Model.ServiceDetailId"
                       class="btn-app-warning">

                        <i class="bi bi-pencil-square"></i>
                        Güncelle

                    </a>

                </div>

            </div>

        </div>

    </div>

    <div class="col-xl-4">

        <div class="app-card form-info-card">

            <div class="form-info-icon">
                <i class="bi bi-info-circle-fill"></i>
            </div>

            <h5>Servis Detayı</h5>

            <p>
                Bu kayıt, ilgili servis işleminde kullanılan yedek parçayı
                ve kullanılan parça miktarını gösterir.
            </p>

            <ul class="form-info-list">

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Servis kayıt numarası görüntülenir
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Kullanılan yedek parça görüntülenir
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Kullanılan miktar görüntülenir
                </li>

            </ul>

        </div>

    </div>

</div>