@using AutoService.Web.Security
@model List<AutoService.Dto.SparePartDtos.ResultSparePartDto>

@{
    ViewData["Title"] = "Yedek Parçalar";

    var keyword = ViewBag.Keyword as string;

    var currentPage = ViewBag.CurrentPage != null
        ? Convert.ToInt32(ViewBag.CurrentPage)
        : 1;

    var totalPage = ViewBag.TotalPage != null
        ? Convert.ToInt32(ViewBag.TotalPage)
        : 1;

    var totalCount = ViewBag.TotalCount != null
        ? Convert.ToInt32(ViewBag.TotalCount)
        : Model.Count;

    var lowStockCount = Model.Count(x =>
        x.StockQuantity > 0 &&
        x.StockQuantity <= 5);

    var outOfStockCount = Model.Count(x =>
        x.StockQuantity <= 0);

    var pageStockValue = Model.Sum(x =>
        x.UnitPrice * x.StockQuantity);

    var canManageSpareParts =
        User.IsInRole(AppRoles.Admin) ||
        User.IsInRole(AppRoles.ServiceAdvisor);
}

<div class="page-header">

    <div>

        <div class="page-header-label">
            <i class="bi bi-box-seam-fill"></i>
            Stok Yönetimi
        </div>

        <h1>Yedek Parçalar</h1>

        <p>
            Parça stoklarını, fiyatlarını ve ürün kodlarını yönetin.
        </p>

    </div>

    @if (canManageSpareParts)
    {
        <a asp-action="Create"
           class="btn-app-primary">

            <i class="bi bi-plus-circle-fill"></i>

            Yeni Parça

        </a>
    }

</div>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4"
         role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4"
         role="alert">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}
<div class="row g-4 mb-4">

    <div class="col-xl-3 col-md-6">

        <div class="dashboard-alert dashboard-alert-primary">

            <div class="dashboard-alert-icon icon-primary">
                <i class="bi bi-box-seam-fill"></i>
            </div>

            <div class="dashboard-alert-content">

                <strong>@totalCount</strong>

                <span>
                    Arama sonucundaki parça
                </span>

            </div>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="dashboard-alert dashboard-alert-success">

            <div class="dashboard-alert-icon icon-success">
                <i class="bi bi-cash-stack"></i>
            </div>

            <div class="dashboard-alert-content">

                <strong>
                    @pageStockValue.ToString("N2") ₺
                </strong>

                <span>
                    Bu sayfadaki stok değeri
                </span>

            </div>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="dashboard-alert dashboard-alert-warning">

            <div class="dashboard-alert-icon icon-warning">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <div class="dashboard-alert-content">

                <strong>@lowStockCount</strong>

                <span>
                    Düşük stoklu parça
                </span>

            </div>

        </div>

    </div>

    <div class="col-xl-3 col-md-6">

        <div class="dashboard-alert dashboard-alert-danger">

            <div class="dashboard-alert-icon icon-danger">
                <i class="bi bi-x-octagon-fill"></i>
            </div>

            <div class="dashboard-alert-content">

                <strong>@outOfStockCount</strong>

                <span>
                    Stokta olmayan parça
                </span>

            </div>

        </div>

    </div>

</div>

<div class="app-card">

    <div class="app-card-header">

        <div class="d-flex align-items-center gap-3">

            <div class="chart-header-icon icon-primary">
                <i class="bi bi-boxes"></i>
            </div>

            <div class="app-card-title">

                <h5>Yedek Parça Listesi</h5>

                <span>
                    Parça adı veya parça koduna göre arama yapın
                </span>

            </div>

        </div>

        <span class="app-badge app-badge-primary">

            <i class="bi bi-database"></i>

            @totalCount kayıt

        </span>

    </div>

    <div class="app-card-body">

        <form method="get"
              asp-action="Index"
              class="customer-filter-form">

            <div class="customer-search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       name="keyword"
                       value="@keyword"
                       placeholder="Parça adı veya parça kodu ile ara..."
                       autocomplete="off" />

            </div>

            <button type="submit"
                    class="btn-app-primary">

                <i class="bi bi-search"></i>

                Ara

            </button>

            @if (!string.IsNullOrWhiteSpace(keyword))
            {
                <a asp-action="Index"
                   class="btn-app-secondary">

                    <i class="bi bi-x-circle"></i>

                    Temizle

                </a>
            }

        </form>

    </div>

    <div class="app-card-body p-0">

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="table app-table align-middle mb-0">

                    <thead>

                        <tr>

                            <th>Parça</th>

                            <th>Parça Kodu</th>

                            <th>Birim Fiyat</th>

                            <th>Stok Durumu</th>

                            <th>Kayıt No</th>

                            <th class="text-end">
                                İşlemler
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            var stockClass = item.StockQuantity <= 0
                            ? "stock-out"
                            : item.StockQuantity <= 5
                            ? "stock-low"
                            : "stock-normal";

                            var stockText = item.StockQuantity <= 0
                            ? "Stokta yok"
                            : item.StockQuantity <= 5
                            ? "Düşük stok"
                            : "Stok yeterli";

                            var stockIcon = item.StockQuantity <= 0
                            ? "bi-x-octagon-fill"
                            : item.StockQuantity <= 5
                            ? "bi-exclamation-triangle-fill"
                            : "bi-check-circle-fill";

                            <tr>

                                <td>

                                    <div class="spare-part-identity">

                                        <div class="spare-part-icon">
                                            <i class="bi bi-gear-wide-connected"></i>
                                        </div>

                                        <div>

                                            <div class="spare-part-name">
                                                @item.PartName
                                            </div>

                                            <span class="spare-part-subtitle">
                                                Yedek parça
                                            </span>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.PartCode))
                                    {
                                        <span class="part-code-badge">
                                            @item.PartCode
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="customer-empty-value">

                                            <i class="bi bi-dash-circle"></i>

                                            Kod yok

                                        </span>
                                    }

                                </td>

                                <td>

                                    <span class="spare-part-price">
                                        @item.UnitPrice.ToString("N2") ₺
                                    </span>

                                </td>

                                <td>

                                    <div class="stock-status @stockClass">

                                        <i class="bi @stockIcon"></i>

                                        <div>

                                            <strong>
                                                @item.StockQuantity adet
                                            </strong>

                                            <span>
                                                @stockText
                                            </span>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    <span class="customer-id-badge">
                                        #@item.SparePartId
                                    </span>

                                </td>

                                <td>

                                    <div class="table-actions justify-content-end">

                                        <a asp-action="Detail"
                                           asp-route-id="@item.SparePartId"
                                           class="table-action-btn action-detail"
                                           title="Detay">

                                            <i class="bi bi-eye-fill"></i>

                                        </a>

                                        @if (canManageSpareParts)
                                        {
                                            <a asp-action="Update"
                                               asp-route-id="@item.SparePartId"
                                               class="table-action-btn action-edit"
                                               title="Düzenle">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                            <button type="button"
                                                    class="table-action-btn action-delete deleteBtn"
                                                    title="Sil"
                                                    data-id="@item.SparePartId"
                                                    data-name="@item.PartName"
                                                    data-code="@item.PartCode">

                                                <i class="bi bi-trash3-fill"></i>

                                            </button>
                                        }

                                    </div>

                                    @if (canManageSpareParts)
                                    {
                                        <form id="delete-@item.SparePartId"
                                              asp-action="Delete"
                                              asp-route-id="@item.SparePartId"
                                              method="post"
                                              class="d-none">

                                            @Html.AntiForgeryToken()

                                        </form>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="dashboard-empty-state customer-empty-state">

                <i class="bi bi-box-seam"></i>

                <h6>Yedek parça bulunamadı</h6>

                @if (!string.IsNullOrWhiteSpace(keyword))
                {
                    <span>
                        “@keyword” aramasına uygun yedek parça bulunamadı.
                    </span>

                    <a asp-action="Index"
                       class="btn-app-secondary mt-3">

                        <i class="bi bi-arrow-counterclockwise"></i>

                        Tüm parçaları göster

                    </a>
                }
                else
                {
                    <span>
                        Sistemde henüz yedek parça bulunmuyor.
                    </span>

                    @if (canManageSpareParts)
                    {
                        <a asp-action="Create"
                           class="btn-app-primary mt-3">

                            <i class="bi bi-plus-circle-fill"></i>

                            İlk parçayı ekle

                        </a>
                    }
                }

            </div>
        }

    </div>

    @if (totalPage > 1)
    {
        <div class="app-card-footer customer-pagination-footer">

            <div class="pagination-info">

                <i class="bi bi-file-earmark-text"></i>

                <span>
                    Sayfa @currentPage / @totalPage
                </span>

            </div>

            <nav aria-label="Yedek parça sayfaları">

                <ul class="pagination app-pagination mb-0">

                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="1"
                           asp-route-keyword="@keyword"
                           title="İlk sayfa">

                            <i class="bi bi-chevron-double-left"></i>

                        </a>

                    </li>

                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-keyword="@keyword"
                           title="Önceki sayfa">

                            <i class="bi bi-chevron-left"></i>

                        </a>

                    </li>

                    @{
                        var startPage = Math.Max(1, currentPage - 2);
                        var endPage = Math.Min(totalPage, currentPage + 2);
                    }

                    @if (startPage > 1)
                    {
                        <li class="page-item">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="1"
                               asp-route-keyword="@keyword">
                                1
                            </a>

                        </li>

                        @if (startPage > 2)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">…</span>
                            </li>
                        }
                    }

                    @for (var i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-keyword="@keyword">
                                @i
                            </a>

                        </li>
                    }

                    @if (endPage < totalPage)
                    {
                        @if (endPage < totalPage - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">…</span>
                            </li>
                        }

                        <li class="page-item">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@totalPage"
                               asp-route-keyword="@keyword">
                                @totalPage
                            </a>

                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPage ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-keyword="@keyword"
                           title="Sonraki sayfa">

                            <i class="bi bi-chevron-right"></i>

                        </a>

                    </li>

                    <li class="page-item @(currentPage >= totalPage ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@totalPage"
                           asp-route-keyword="@keyword"
                           title="Son sayfa">

                            <i class="bi bi-chevron-double-right"></i>

                        </a>

                    </li>

                </ul>

            </nav>

        </div>
    }

</div>

@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const deleteButtons =
                document.querySelectorAll(".deleteBtn");

            deleteButtons.forEach(function (button) {

                button.addEventListener("click", function () {

                    const id = this.dataset.id;
                    const name = this.dataset.name;
                    const code = this.dataset.code;

                    let description =
                        "<strong>" +
                        escapeHtml(name) +
                        "</strong> adlı yedek parça silinecek.";

                    if (code) {
                        description +=
                            "<br><small>Parça kodu: " +
                            escapeHtml(code) +
                            "</small>";
                    }

                    Swal.fire({

                        title: "Yedek parça silinsin mi?",

                        html: description,

                        icon: "warning",

                        showCancelButton: true,

                        reverseButtons: true,

                        focusCancel: true,

                        confirmButtonColor: "#dc2626",

                        cancelButtonColor: "#64748b",

                        confirmButtonText:
                            '<i class="bi bi-trash3-fill me-1"></i> Evet, sil',

                        cancelButtonText:
                            '<i class="bi bi-x-circle me-1"></i> İptal'

                    }).then(function (result) {

                        if (result.isConfirmed) {

                            const form =
                                document.getElementById(
                                    "delete-" + id
                                );

                            if (form) {
                                form.submit();
                            }

                        }

                    });

                });

            });

        });

        function escapeHtml(value) {

            const element =
                document.createElement("div");

            element.textContent = value || "";

            return element.innerHTML;

        }

    </script>
}