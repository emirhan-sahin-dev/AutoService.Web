@model AutoService.Dto.AppointmentDtos.AppointmentDetailDto

@using AutoService.Entity.Enums

@{
    ViewData["Title"] = "Randevu Detayı";

    var statusText = Model.Status switch
    {
        AppointmentStatus.Waiting => "Bekliyor",
        AppointmentStatus.Confirmed => "Onaylandı",
        AppointmentStatus.Arrived => "Servise Geldi",
        AppointmentStatus.Completed => "Tamamlandı",
        AppointmentStatus.Cancelled => "İptal Edildi",
        _ => Model.Status.ToString()
    };

    var statusClass = Model.Status switch
    {
        AppointmentStatus.Waiting => "app-badge-warning",
        AppointmentStatus.Confirmed => "app-badge-primary",
        AppointmentStatus.Arrived => "app-badge-info",
        AppointmentStatus.Completed => "app-badge-success",
        AppointmentStatus.Cancelled => "app-badge-danger",
        _ => "app-badge-secondary"
    };

    var statusIcon = Model.Status switch
    {
        AppointmentStatus.Waiting => "bi-clock-fill",
        AppointmentStatus.Confirmed => "bi-check-circle-fill",
        AppointmentStatus.Arrived => "bi-car-front-fill",
        AppointmentStatus.Completed => "bi-check2-circle",
        AppointmentStatus.Cancelled => "bi-x-circle-fill",
        _ => "bi-circle-fill"
    };
}

<style>
    .appointment-detail-hero {
        display: grid;
        grid-template-columns: 320px minmax(0, 1fr);
        gap: 24px;
        align-items: start;
    }

    .appointment-profile {
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        overflow: hidden;
        background: #fff;
    }

    .appointment-profile-cover {
        height: 112px;
        background: linear-gradient(135deg, #1d4ed8, #06b6d4);
        position: relative;
    }

    .appointment-profile-icon {
        position: absolute;
        left: 24px;
        bottom: -32px;
        width: 66px;
        height: 66px;
        border-radius: 18px;
        display: grid;
        place-items: center;
        background: #fff;
        color: #2563eb;
        font-size: 28px;
        box-shadow: 0 12px 24px rgba(15, 23, 42, .14);
    }

    .appointment-profile-body {
        padding: 48px 22px 22px;
    }

        .appointment-profile-body h4 {
            margin: 0;
            font-size: 21px;
            font-weight: 900;
        }

        .appointment-profile-body p {
            margin: 6px 0 0;
            color: #667085;
            font-size: 13px;
        }

    .appointment-profile-meta {
        display: grid;
        gap: 12px;
        margin-top: 20px;
    }

        .appointment-profile-meta div {
            padding: 12px 14px;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            background: #f8fafc;
        }

        .appointment-profile-meta span {
            display: block;
            color: #667085;
            font-size: 11px;
            margin-bottom: 4px;
        }

        .appointment-profile-meta strong {
            display: block;
            font-size: 13px;
            color: #172033;
        }

    .appointment-detail-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .appointment-detail-item {
        display: flex;
        gap: 13px;
        align-items: flex-start;
        padding: 15px;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #fff;
    }

    .appointment-detail-icon {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: #eff6ff;
        color: #2563eb;
        flex: 0 0 auto;
    }

    .appointment-detail-item span {
        display: block;
        color: #667085;
        font-size: 11px;
        margin-bottom: 4px;
    }

    .appointment-detail-item strong {
        display: block;
        color: #172033;
        font-size: 13px;
        line-height: 1.45;
    }

    .appointment-note {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 16px;
        background: #fbfdff;
        white-space: pre-wrap;
        line-height: 1.6;
        color: #475467;
        min-height: 100px;
    }

    @@media (max-width: 992px) {
        .appointment-detail-hero,
        .appointment-detail-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="page-header">
    <div>
        <div class="page-header-label">
            <i class="bi bi-calendar2-check-fill"></i>
            Randevu Yönetimi
        </div>

        <h1>Randevu Detayı</h1>

        <p>
            Müşteri, araç, tarih ve servis talebi bilgilerini görüntüleyin.
        </p>
    </div>

    <div class="d-flex gap-2 flex-wrap">

        @if (!Model.ServiceRecordId.HasValue)
        {
            <a asp-action="Update"
               asp-route-id="@Model.AppointmentId"
               class="btn-app-warning">

                <i class="bi bi-pencil-square"></i>
                Güncelle

            </a>

            @if (Model.Status != AppointmentStatus.Cancelled)
            {
                <form asp-action="ConvertToService"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.AppointmentId" />

                    <button type="submit"
                            class="btn-app-primary">

                        <i class="bi bi-arrow-repeat"></i>
                        Servis Kaydı Oluştur

                    </button>

                </form>
            }
        }
        else
        {
            <a asp-controller="ServiceRecord"
               asp-action="Detail"
               asp-route-id="@Model.ServiceRecordId"
               class="btn-app-primary">

                <i class="bi bi-wrench-adjustable-circle-fill"></i>
                Servis Kaydını Aç

            </a>
        }

        <a asp-action="Index"
           class="btn-app-secondary">

            <i class="bi bi-arrow-left"></i>
            Randevu Listesi

        </a>

    </div>
</div>

<div class="appointment-detail-hero">

    <div class="appointment-profile">
        <div class="appointment-profile-cover">
            <div class="appointment-profile-icon">
                <i class="bi bi-car-front-fill"></i>
            </div>
        </div>

        <div class="appointment-profile-body">
            <h4>@Model.CustomerName</h4>
            <p>@Model.Plate · @Model.BrandName @Model.ModelName</p>

            <div class="mt-3">
                <span class="app-badge @statusClass">
                    <i class="bi @statusIcon"></i>
                    @statusText
                </span>
            </div>

            <div class="appointment-profile-meta">
                <div>
                    <span>Randevu No</span>
                    <strong>#@Model.AppointmentId</strong>
                </div>

                <div>
                    <span>Randevu Tarihi</span>
                    <strong>@Model.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</strong>
                </div>

                <div>
                    <span>Oluşturulma Tarihi</span>
                    <strong>@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</strong>
                </div>
            </div>
        </div>
    </div>

    <div>

        <div class="app-card mb-4">
            <div class="app-card-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="chart-header-icon icon-primary">
                        <i class="bi bi-person-vcard-fill"></i>
                    </div>

                    <div class="app-card-title">
                        <h5>Müşteri ve Araç Bilgileri</h5>
                        <span>Randevuya bağlı müşteri ve araç detayları</span>
                    </div>
                </div>
            </div>

            <div class="app-card-body">
                <div class="appointment-detail-grid">
                    <div class="appointment-detail-item">
                        <div class="appointment-detail-icon">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div>
                            <span>Müşteri</span>
                            <strong>@Model.CustomerName</strong>
                        </div>
                    </div>

                    <div class="appointment-detail-item">
                        <div class="appointment-detail-icon">
                            <i class="bi bi-telephone-fill"></i>
                        </div>
                        <div>
                            <span>Telefon</span>
                            <strong>@Model.CustomerPhone</strong>
                        </div>
                    </div>

                    <div class="appointment-detail-item">
                        <div class="appointment-detail-icon">
                            <i class="bi bi-envelope-fill"></i>
                        </div>
                        <div>
                            <span>E-Posta</span>
                            <strong>@Model.CustomerEmail</strong>
                        </div>
                    </div>

                    <div class="appointment-detail-item">
                        <div class="appointment-detail-icon">
                            <i class="bi bi-credit-card-2-front-fill"></i>
                        </div>
                        <div>
                            <span>Plaka</span>
                            <strong>@Model.Plate</strong>
                        </div>
                    </div>

                    <div class="appointment-detail-item">
                        <div class="appointment-detail-icon">
                            <i class="bi bi-car-front-fill"></i>
                        </div>
                        <div>
                            <span>Marka / Model</span>
                            <strong>@Model.BrandName @Model.ModelName</strong>
                        </div>
                    </div>

                    <div class="appointment-detail-item">
                        <div class="appointment-detail-icon">
                            <i class="bi bi-calendar3"></i>
                        </div>
                        <div>
                            <span>Model Yılı</span>
                            <strong>@Model.ModelYear</strong>
                        </div>
                    </div>

                    <div class="appointment-detail-item">
                        <div class="appointment-detail-icon">
                            <i class="bi bi-upc-scan"></i>
                        </div>
                        <div>
                            <span>Şasi No</span>
                            <strong>@Model.VinNumber</strong>
                        </div>
                    </div>

                    <div class="appointment-detail-item">
                        <div class="appointment-detail-icon">
                            <i class="bi bi-link-45deg"></i>
                        </div>
                        <div>
                            <span>Servis Kaydı</span>
                            <strong>
                                @(Model.ServiceRecordId.HasValue
                                                                ? $"Servis #{Model.ServiceRecordId}"
                                                                : "Henüz oluşturulmadı")
                            </strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="app-card-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="chart-header-icon icon-warning">
                        <i class="bi bi-chat-left-text-fill"></i>
                    </div>

                    <div class="app-card-title">
                        <h5>Randevu Açıklamaları</h5>
                        <span>Müşteri talebi ve servis içi notlar</span>
                    </div>
                </div>
            </div>

            <div class="app-card-body">
                <div class="mb-4">
                    <label class="app-form-label">
                        <i class="bi bi-person-exclamation"></i>
                        Müşteri Talebi
                    </label>

                    <div class="appointment-note">
                        @Model.CustomerRequest
                    </div>
                </div>

                <div>
                    <label class="app-form-label">
                        <i class="bi bi-card-text"></i>
                        Açıklama
                    </label>

                    <div class="appointment-note">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                                                ? "Açıklama bulunmuyor."
                                                : Model.Description)
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
