@model AutoService.Dto.BrandDtos.GetByIdBrandDto

@{
    ViewData["Title"] = "Marka Detayı";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header">
            <h3>Marka Detayı</h3>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Marka ID
                </dt>

                <dd class="col-sm-9">
                    @Model.BrandId
                </dd>

                <dt class="col-sm-3">
                    Marka Adı
                </dt>

                <dd class="col-sm-9">
                    @Model.BrandName
                </dd>

            </dl>

            <a asp-action="Update"
               asp-route-id="@Model.BrandId"
               class="btn btn-warning">

                Güncelle

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                Listeye Dön

            </a>

        </div>

    </div>

</div>