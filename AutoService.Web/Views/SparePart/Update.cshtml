@model AutoService.Dto.SparePartDtos.UpdateSparePartDto

@{
    ViewData["Title"] = "Yedek Parça Güncelle";
}

<div class="page-header">

    <div>

        <div class="page-header-label">
            <i class="bi bi-pencil-square"></i>
            Yedek Parça Yönetimi
        </div>

        <h1>Yedek Parçayı Güncelle</h1>

        <p>
            Kayıtlı parçanın fiyat, kod ve stok bilgilerini düzenleyin.
        </p>

    </div>

    <a asp-action="Index"
       class="btn-app-secondary">

        <i class="bi bi-arrow-left"></i>
        Parça Listesi

    </a>

</div>

<div class="row g-4">

    <div class="col-xl-8">

        <div class="app-card">

            <div class="app-card-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="chart-header-icon icon-warning">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>

                    <div class="app-card-title">

                        <h5>Parça Bilgilerini Düzenle</h5>

                        <span>
                            Mevcut stok kartındaki bilgileri güncelleyin
                        </span>

                    </div>

                </div>

                <span class="app-badge app-badge-warning">

                    <i class="bi bi-hash"></i>
                    @Model.SparePartId

                </span>

            </div>

            <div class="app-card-body">

                <form asp-action="Update"
                      method="post"
                      class="app-form">

                    <input type="hidden"
                           asp-for="SparePartId" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="spare-part-form-visual spare-part-form-warning">

                        <div class="spare-part-form-icon">
                            <i class="bi bi-pencil-square"></i>
                        </div>

                        <div>

                            <strong>Stok kartı güncelleniyor</strong>

                            <span>
                                Fiyat veya stok değişiklikleri sonraki servis
                                işlemlerini doğrudan etkileyebilir.
                            </span>

                        </div>

                    </div>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <div class="app-form-group">

                                <label asp-for="PartName"
                                       class="app-form-label">

                                    <i class="bi bi-box-fill"></i>
                                    Parça Adı
                                    <span>*</span>

                                </label>

                                <div class="app-input-wrapper">

                                    <i class="bi bi-box-seam"></i>

                                    <input asp-for="PartName"
                                           class="app-form-control"
                                           autocomplete="off" />

                                </div>

                                <span asp-validation-for="PartName"
                                      class="app-validation-message">
                                </span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="app-form-group">

                                <label asp-for="PartCode"
                                       class="app-form-label">

                                    <i class="bi bi-upc-scan"></i>
                                    Parça Kodu
                                    <span>*</span>

                                </label>

                                <div class="app-input-wrapper">

                                    <i class="bi bi-upc"></i>

                                    <input asp-for="PartCode"
                                           class="app-form-control spare-part-code-input"
                                           autocomplete="off" />

                                </div>

                                <span asp-validation-for="PartCode"
                                      class="app-validation-message">
                                </span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="app-form-group">

                                <label asp-for="UnitPrice"
                                       class="app-form-label">

                                    <i class="bi bi-tag-fill"></i>
                                    Birim Fiyat
                                    <span>*</span>

                                </label>

                                <div class="app-input-wrapper">

                                    <i class="bi bi-currency-exchange"></i>

                                    <input asp-for="UnitPrice"
                                           class="app-form-control" />

                                </div>

                                <span asp-validation-for="UnitPrice"
                                      class="app-validation-message">
                                </span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="app-form-group">

                                <label asp-for="StockQuantity"
                                       class="app-form-label">

                                    <i class="bi bi-boxes"></i>
                                    Stok Miktarı
                                    <span>*</span>

                                </label>

                                <div class="app-input-wrapper">

                                    <i class="bi bi-123"></i>

                                    <input asp-for="StockQuantity"
                                           type="number"
                                           min="0"
                                           class="app-form-control" />

                                </div>

                                <span asp-validation-for="StockQuantity"
                                      class="app-validation-message">
                                </span>

                            </div>

                        </div>

                    </div>

                    <div class="spare-part-stock-notice warning">

                        <i class="bi bi-exclamation-triangle-fill"></i>

                        <div>

                            <strong>Stok değişikliği uyarısı</strong>

                            <span>
                                Stok miktarını yalnızca fiziksel envanterle
                                uyumlu olacak şekilde güncelleyin.
                            </span>

                        </div>

                    </div>

                    <div class="app-form-actions">

                        <a asp-action="Index"
                           class="btn-app-secondary">

                            <i class="bi bi-x-circle"></i>
                            Vazgeç

                        </a>

                        <button type="submit"
                                class="btn-app-warning">

                            <i class="bi bi-check-circle-fill"></i>
                            Değişiklikleri Kaydet

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <div class="col-xl-4">

        <div class="app-card form-info-card form-info-warning">

            <div class="form-info-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>

            <h5>Güncelleme Bilgisi</h5>

            <p>
                Burada yapılan değişiklikler stok raporlarını ve servis
                maliyetlerini etkileyebilir.
            </p>

            <ul class="form-info-list">

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Parça adını kontrol edin
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Parça kodunu değiştirmeden önce doğrulayın
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Güncel birim fiyatı yazın
                </li>

                <li>
                    <i class="bi bi-check-circle-fill"></i>
                    Fiziksel stokla sistemi eşleştirin
                </li>

            </ul>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        $(document).ready(function () {

            $(".spare-part-code-input").on("input", function () {
                this.value = this.value.toUpperCase();
            });

        });

    </script>
}